import re
from pathlib import Path
from glob import glob

import pandas as pd

CAPTION_SCENE_INTERMEDIATE_DIR = "results/mind/caption_scene/intermediate_files"
CAPTION_SCENE_PROCESSING_OUTPUT_DIR = config["caption_scene"]["processing_output_dir"]
CAPTION_SCENE_ISC_DIR = f"{config['caption_scene']['processing_output_dir']}/isc"

CAPTION_SCENE_BOLD_GLOB = config["caption_scene"]["bold_glob"]

CAPTION_SCENE_GLOBAL_MANIFEST = f"{CAPTION_SCENE_INTERMEDIATE_DIR}/manifest/csd_events_manifest.tsv"

CAPTION_SCENE_STIMULI_TABLE = config["caption_scene"]["stimuli"]
CAPTION_SCENE_IMAGE_CAPTION_TSV = "resources/datasets/caption_scene_dataset/V1/stimuli/COCO_CN/Image_caption_pairs.tsv"

def caption_scene_parse_bold_path(path):
    name = Path(path).name

    pattern = (
        r"sub-(?P<subject>[^_]+)"
        r"_ses-(?P<session>[^_]+)"
        r"_task-CSD"
        r"_run-(?P<run>[^.]+)"
        r"\.nii\.gz$"
    )

    match = re.match(pattern, name)

    if match is None:
        raise ValueError(f"Could not parse subject/session/run from BOLD file: {path}")

    return match.groupdict()

def caption_scene_normalize_int_string(value):
    return str(int(value))

def caption_scene_sample_key(subject, session, run):
    return f"sub-{subject}_ses-{session}_run-{run}"

def caption_scene_run_table_path(subject, run):
    subject_int = caption_scene_normalize_int_string(subject)
    run_int = caption_scene_normalize_int_string(run)

    return str(
        Path("resources/datasets/caption_scene_dataset/V1/stimuli/CSD")
        / f"sub-{subject}"
        / f"subject{subject_int}_run{run_int}.txt"
    )

CAPTION_SCENE_BOLD_FILES = sorted(glob(CAPTION_SCENE_BOLD_GLOB))

if len(CAPTION_SCENE_BOLD_FILES) == 0:
    raise ValueError(f"No BOLD files found with glob: {CAPTION_SCENE_BOLD_GLOB}")

CAPTION_SCENE_RUNS = []
CAPTION_SCENE_BOLD_BY_KEY = {}
CAPTION_SCENE_RUN_TABLE_BY_KEY = {}

for bold_file in CAPTION_SCENE_BOLD_FILES:
    fields = caption_scene_parse_bold_path(bold_file)

    subject = fields["subject"]
    session = fields["session"]
    run = fields["run"]

    key = caption_scene_sample_key(subject, session, run)

    if key in CAPTION_SCENE_BOLD_BY_KEY:
        raise ValueError(f"Duplicate BOLD key found: {key}")

    run_table = caption_scene_run_table_path(subject, run)

    if not Path(run_table).exists():
        raise FileNotFoundError(f"Missing run table for {key}: {run_table}")

    CAPTION_SCENE_BOLD_BY_KEY[key] = bold_file
    CAPTION_SCENE_RUN_TABLE_BY_KEY[key] = run_table

    CAPTION_SCENE_RUNS.append(
        {
            "key": key,
            "subject": subject,
            "session": session,
            "run": run,
            "bold": bold_file,
            "run_table": run_table,
        }
    )

CAPTION_SCENE_RUN_TABLES = [x["run_table"] for x in CAPTION_SCENE_RUNS]

def caption_scene_bold_input_from_wildcards(wildcards):
    subject = f"{int(wildcards.subject):02d}"
    session = f"{int(wildcards.session):02d}"
    run = f"{int(wildcards.run):03d}"

    key = caption_scene_sample_key(subject, session, run)

    if key not in CAPTION_SCENE_BOLD_BY_KEY:
        print("\nREQUESTED KEY:")
        print(key)

        print("\nAVAILABLE KEYS (first 50):")
        for available_key in sorted(CAPTION_SCENE_BOLD_BY_KEY.keys())[:50]:
            print(available_key)

        raise KeyError(key)

    return CAPTION_SCENE_BOLD_BY_KEY[key]

def read_manifest(path=CAPTION_SCENE_GLOBAL_MANIFEST):
    df = pd.read_csv(path, sep="\t")

    for column in [
        "subject",
        "session",
        "run",
        "event_index",
        "stimulus_id",
        "output_bold",
    ]:
        if column in df.columns:
            df[column] = df[column].astype(str)

    return df

def all_caption_scene_outputs(wildcards):
    checkpoint_output = checkpoints.make_caption_scene_manifest.get().output.manifest
    df = read_manifest(checkpoint_output)

    stimuli = sorted(df["stimulus_id"].dropna().unique().tolist())

    isc_nii_files = [
        f"{CAPTION_SCENE_ISC_DIR}/task-{stimulus_id}_isc_mean.nii.gz"
        for stimulus_id in stimuli
    ]

    return isc_nii_files + [CAPTION_SCENE_STIMULI_TABLE]

def caption_scene_task_parcel_inputs(wildcards):
    df = read_manifest()

    rows = df[df["stimulus_id"] == str(wildcards.task)]

    if len(rows) == 0:
        raise ValueError(f"No rows found in manifest for stimulus_id={wildcards.task}")

    return [
        (
            f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/parcels/task-{row.stimulus_id}/"
            f"sub-{row.subject}_ses-{row.session}_run-{row.run}"
            f"_task-{row.stimulus_id}_event-{row.event_index}_parcel_ts.npy"
        )
        for row in rows.itertuples(index=False)
    ]

CAPTION_SCENE_ISC_DONE = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/manifests/isc.done"

rule all_caption_scene_dataset:
    input:
        all_caption_scene_outputs,
        CAPTION_SCENE_ISC_DONE

rule mark_caption_scene_isc_done:
    input:
        all_caption_scene_outputs
    output:
        touch(CAPTION_SCENE_ISC_DONE)

checkpoint make_caption_scene_manifest:
    input:
        bold_files=CAPTION_SCENE_BOLD_FILES,
        run_tables=CAPTION_SCENE_RUN_TABLES,
    output:
        manifest=CAPTION_SCENE_GLOBAL_MANIFEST,
    params:
        output_root=CAPTION_SCENE_INTERMEDIATE_DIR,
        tr=config["caption_scene"]["tr"],
        event_duration_s=config["caption_scene"]["event_duration_s"],
        onset_shift_s=config["caption_scene"]["onset_shift_s"],
        run_table_encoding=config["caption_scene"].get("run_table_encoding", "gbk"),
    conda:
        "envs/make_caption_scene_manifest_environment.yaml"
    shell:
        r"""
            python workflow/dataset_processing/caption_scene_dataset/scripts/make_caption_scene_manifest.py \
                --bold_files {input.bold_files:q} \
                --run_tables {input.run_tables:q} \
                --output_manifest {output.manifest:q} \
                --output_root {params.output_root:q} \
                --tr {params.tr} \
                --event_duration_s {params.event_duration_s} \
                --onset_shift_s {params.onset_shift_s} \
                --run_table_encoding {params.run_table_encoding:q}
        """

rule create_caption_scene_stimuli_table:
    input:
        caption_scene_tsv=CAPTION_SCENE_IMAGE_CAPTION_TSV
    output:
        stimuli_table=CAPTION_SCENE_STIMULI_TABLE
    conda:
        "envs/create_caption_scene_stimuli_table_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/create_caption_scene_stimuli_table.py \
                --caption_scene_tsv {input.caption_scene_tsv:q} \
                --output {output.stimuli_table:q}
        """

rule split_bold_by_run_manifest:
    input:
        manifest=CAPTION_SCENE_GLOBAL_MANIFEST,
        bold=caption_scene_bold_input_from_wildcards,
    output:
        bold=(
            f"{CAPTION_SCENE_INTERMEDIATE_DIR}/single_stimulus_bold/"
            "sub-{subject}/ses-{session}/run-{run}/"
            "{task}_event-{event_index}.nii.gz"
        ),
    conda:
        "envs/split_bold_by_run_manifest_environment.yaml"
    shell:
        r"""
            python workflow/dataset_processing/caption_scene_dataset/scripts/split_bold_by_run_manifest.py \
                --bold {input.bold:q} \
                --manifest {input.manifest:q} \
                --subject {wildcards.subject:q} \
                --session {wildcards.session:q} \
                --run {wildcards.run:q} \
                --stimulus_id {wildcards.task:q} \
                --event_index {wildcards.event_index:q} \
                --output_bold {output.bold:q}
        """

rule extract_caption_scene_parcels:
    input:
        bold_file=(
            f"{CAPTION_SCENE_INTERMEDIATE_DIR}/single_stimulus_bold/"
            "sub-{subject}/ses-{session}/run-{run}/"
            "{task}_event-{event_index}.nii.gz"
        ),
    output:
        parcel_ts=(
            f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/parcels/task-{{task}}/"
            "sub-{subject}_ses-{session}_run-{run}_"
            "task-{task}_event-{event_index}_parcel_ts.npy"
        ),
    params:
        n_rois=config["atlas"]["n_rois"],
        yeo_networks=config["atlas"]["yeo_networks"],
        atlas_dir=config["atlas"]["atlas_dir"],
    conda:
        "envs/extract_parcels_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/extract_parcels.py \
                --bold_file {input.bold_file:q} \
                --parcel_ts {output.parcel_ts:q} \
                --n_rois {params.n_rois} \
                --yeo_networks {params.yeo_networks} \
                --atlas_dir {params.atlas_dir:q}
        """

rule compute_caption_scene_isc:
    input:
        caption_scene_task_parcel_inputs,
    output:
        isc_npy=f"{CAPTION_SCENE_INTERMEDIATE_DIR}/isc/task-{{task}}_isc_mean.npy",
        isc_nii=f"{CAPTION_SCENE_ISC_DIR}/task-{{task}}_isc_mean.nii.gz",
    params:
        n_rois=config["atlas"]["n_rois"],
        yeo_networks=config["atlas"]["yeo_networks"],
        atlas_dir=config["atlas"]["atlas_dir"],
    conda:
        "envs/compute_isc_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/compute_isc.py \
                --parcel_ts {input:q} \
                --isc_npy {output.isc_npy:q} \
                --isc_nii {output.isc_nii:q} \
                --n_rois {params.n_rois} \
                --yeo_networks {params.yeo_networks} \
                --atlas_dir {params.atlas_dir:q}
        """