import pandas as pd

CAPTION_SCENE_INTERMEDIATE_DIR = "results/mind/caption_scene/intermediate_files"
CAPTION_SCENE_PROCESSING_OUTPUT_DIR = config["caption_scene"]["processing_output_dir"]
CAPTION_SCENE_ISC_DIR = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/isc"

CAPTION_SCENE_BOLD_GLOB = config["caption_scene"]["bold_glob"]
# the record of every event window (crop) used for the ISC: kept permanently, next to isc_inputs.tsv
CAPTION_SCENE_MANIFEST = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/manifests/csd_events_manifest.tsv"
CAPTION_SCENE_RUN_MANIFEST_DIR = f"{CAPTION_SCENE_INTERMEDIATE_DIR}/manifest/by_run"
CAPTION_SCENE_RUN_MANIFEST_INDEX = f"{CAPTION_SCENE_INTERMEDIATE_DIR}/manifest/by_run_manifest_index.tsv"

CAPTION_SCENE_PARCELS_DONE = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/manifests/.parcels_done"
CAPTION_SCENE_RUN_PARCELS_DONE = f"{CAPTION_SCENE_INTERMEDIATE_DIR}/parcel_flags/{{run_key}}.done"

# the BOLD data are in each subject's T1w space: they are warped to MNI152NLin6Asym (the space of
# the Schaefer atlas) through a registration of the subject's T1w to the template
CAPTION_SCENE_REGISTRATION_DIR = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/registration"
CAPTION_SCENE_T1W = config["caption_scene"]["t1w_pattern"]
MNI_TEMPLATE = f"{config['atlas']['atlas_dir']}/tpl-MNI152NLin6Asym_res-01_T1w.nii.gz"
MNI_TEMPLATE_URL = "https://templateflow.s3.amazonaws.com/tpl-MNI152NLin6Asym/tpl-MNI152NLin6Asym_res-01_T1w.nii.gz"
CAPTION_SCENE_ISC_DONE = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/manifests/.isc_done"
CAPTION_SCENE_ISC_MANIFEST = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/manifests/isc_manifest.tsv"

CAPTION_SCENE_IMAGE_CAPTION_TSV = "resources/datasets/caption_scene_dataset/V1/stimuli/COCO_CN/Translated_Image_Caption_pairs.tsv"
CAPTION_SCENE_STIMULI_READY = config["caption_scene"]["stimuli_ready"]

CAPTION_SCENE_VISUAL_STIMULI_DIR = config["caption_scene"]["stimuli_dir"]["vision"]
CAPTION_SCENE_EXCLUDED_STIMULI = config["caption_scene"]["excluded_stimuli"]

def caption_scene_parse_bold_path(path):
    name = Path(path).name

    pattern = (
        r"sub-(?P<subject>[^_]+)"
        r"_ses-(?P<session>[^_]+)"
        r"_task-CSD"
        r"_run-(?P<run>[^.]+)"
        r"\.nii\.gz$"
    )

    match = re.match(pattern, name)

    if match is None:
        raise ValueError(f"Could not parse subject/session/run from BOLD file: {path}.")

    return match.groupdict()

def caption_scene_normalize_int_string(value):
    return str(int(value))

def caption_scene_sample_key(subject, session, run):
    return f"sub-{subject}_ses-{session}_run-{run}"

def caption_scene_run_table_path(subject, run):
    subject_int = caption_scene_normalize_int_string(subject)
    run_int = caption_scene_normalize_int_string(run)

    return str(
        Path("resources/datasets/caption_scene_dataset/V1/stimuli/CSD")
        /f"sub-{subject}"
        /f"subject{subject_int}_run{run_int}.txt"
    )

CAPTION_SCENE_BOLD_FILES = sorted(glob(CAPTION_SCENE_BOLD_GLOB))

if len(CAPTION_SCENE_BOLD_FILES) == 0:
    raise ValueError(f"No BOLD files found with glob: {CAPTION_SCENE_BOLD_GLOB}")

CAPTION_SCENE_RUNS = []
CAPTION_SCENE_BOLD_BY_KEY = {}
CAPTION_SCENE_RUN_TABLE_BY_KEY = {}

for bold_file in CAPTION_SCENE_BOLD_FILES:
    fields = caption_scene_parse_bold_path(bold_file)

    subject = fields["subject"]
    session = fields["session"]
    run = fields["run"]

    key = caption_scene_sample_key(subject, session, run)

    if key in CAPTION_SCENE_BOLD_BY_KEY:
        raise ValueError(f"Duplicate BOLD key found: {key}")

    run_table = caption_scene_run_table_path(subject, run)

    if not Path(run_table).exists():
        raise FileNotFoundError(f"Missing run table for {key}: {run_table}.")

    CAPTION_SCENE_BOLD_BY_KEY[key] = bold_file
    CAPTION_SCENE_RUN_TABLE_BY_KEY[key] = run_table

    CAPTION_SCENE_RUNS.append(
        {
            "key": key, 
            "subject": subject, 
            "session": session, 
            "run": run, 
            "bold": bold_file, 
            "run_table": run_table, 
        }
    )

CAPTION_SCENE_RUN_TABLES = [x["run_table"] for x in CAPTION_SCENE_RUNS]
CAPTION_SCENE_SUBJECT_BY_KEY = {x["key"]: x["subject"] for x in CAPTION_SCENE_RUNS}
CAPTION_SCENE_BOLD_BY_SUBJECT = {}

for caption_scene_run in CAPTION_SCENE_RUNS:
    CAPTION_SCENE_BOLD_BY_SUBJECT.setdefault(caption_scene_run["subject"], []).append(caption_scene_run["bold"])

def caption_scene_run_parcel_flags(wildcards):
    # one flag per run with retained events, once the manifest checkpoint has run
    checkpoint_output = checkpoints.make_caption_scene_manifest.get().output.run_manifest_index
    df = pd.read_csv(checkpoint_output, sep = "\t")

    return [
        CAPTION_SCENE_RUN_PARCELS_DONE.format(run_key = run_key)
        for run_key in sorted(df["run_key"].dropna().astype(str).unique())
    ]

# read as text, so zero-padded identifiers (sub-01, run-001) keep their padding in file names,
# as in extract_caption_scene_parcels.py
CAPTION_SCENE_TEXT_COLUMNS = ["subject", "session", "run", "event_index", "stimulus_id"]

def read_manifest(path = CAPTION_SCENE_MANIFEST):
    return pd.read_csv(path, sep = "\t", dtype = {column: str for column in CAPTION_SCENE_TEXT_COLUMNS})

def caption_scene_all_isc_outputs(wildcards):
    checkpoint_output = checkpoints.make_caption_scene_manifest.get().output.manifest
    df = read_manifest(checkpoint_output)

    stimuli = sorted(df["stimulus_id"].dropna().unique().tolist())

    isc_npy_files = [
        f"{CAPTION_SCENE_ISC_DIR}/task-{stimulus_id}_isc_mean.npy"
        for stimulus_id in stimuli
    ]

    return isc_npy_files

rule all_caption_scene_dataset:
    input:
        isc_outputs = caption_scene_all_isc_outputs, 
        isc_done = CAPTION_SCENE_ISC_DONE, 
        stimuli_ready = CAPTION_SCENE_STIMULI_READY, 
        excluded_stimuli = CAPTION_SCENE_EXCLUDED_STIMULI

rule finish_caption_scene_isc:
    input:
        isc_outputs = caption_scene_all_isc_outputs
    output:
        isc_done = touch(CAPTION_SCENE_ISC_DONE)

MAKE_CAPTION_SCENE_MANIFEST_SCRIPT = "workflow/dataset_processing/caption_scene_dataset/scripts/make_caption_scene_manifest.py"

checkpoint make_caption_scene_manifest:
    input:
        bold_files = CAPTION_SCENE_BOLD_FILES, 
        run_tables = CAPTION_SCENE_RUN_TABLES, 
        visual_stimuli_dir = CAPTION_SCENE_VISUAL_STIMULI_DIR
    output:
        excluded_stimuli = CAPTION_SCENE_EXCLUDED_STIMULI, 
        manifest = CAPTION_SCENE_MANIFEST, 
        run_manifest_dir = directory(CAPTION_SCENE_RUN_MANIFEST_DIR), 
        run_manifest_index = CAPTION_SCENE_RUN_MANIFEST_INDEX
    params:
        tr = config["caption_scene"]["tr"], 
        event_duration_s = config["caption_scene"]["event_duration_s"], 
        onset_shift_s = config["caption_scene"]["onset_shift_s"], 
        run_table_encoding = config["caption_scene"].get("run_table_encoding", "gbk"), 
        minimum_subjects_per_stimulus = MINIMUM_SUBJECTS_PER_STIMULUS, 
        code = code_version(MAKE_CAPTION_SCENE_MANIFEST_SCRIPT)
    conda:
        "envs/caption_scene_dataset_processing_environment.yaml"
    shell:
        r"""
            python {MAKE_CAPTION_SCENE_MANIFEST_SCRIPT:q} \
                --bold_files {input.bold_files:q} \
                --run_tables {input.run_tables:q} \
                --visual_stimuli_dir {input.visual_stimuli_dir:q} \
                --output_excluded_stimuli {output.excluded_stimuli:q} \
                --output_manifest {output.manifest:q} \
                --output_run_manifest_dir {output.run_manifest_dir:q} \
                --output_run_manifest_index {output.run_manifest_index:q} \
                --tr {params.tr} \
                --event_duration_s {params.event_duration_s} \
                --onset_shift_s {params.onset_shift_s} \
                --run_table_encoding {params.run_table_encoding:q} \
                --minimum_subjects_per_stimulus {params.minimum_subjects_per_stimulus}
        """

rule fetch_mni_template:
    output:
        template = MNI_TEMPLATE
    params:
        url = MNI_TEMPLATE_URL
    shell:
        r"""
            curl -fsSL -o {output.template:q} {params.url:q}
        """

rule register_caption_scene_t1w:
    # registers the subject's T1w to MNI152NLin6Asym (rigid, affine and SyN); the BOLD runs are
    # already aligned to this T1w by the dataset authors. The QC plot is the only output kept
    # besides the transforms
    input:
        t1w = CAPTION_SCENE_T1W, 
        template = MNI_TEMPLATE
    output:
        affine = f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_0GenericAffine.mat", 
        warp = f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_1Warp.nii.gz", 
        inverse_warp = temp(f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_1InverseWarp.nii.gz"), 
        warped_t1w = temp(f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_Warped.nii.gz"), 
        inverse_warped_template = temp(f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_InverseWarped.nii.gz"), 
        qc = f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_t1w_to_mni_qc.png"
    params:
        prefix = f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_", 
        random_seed = RANDOM_SEED
    threads:
        8
    conda:
        "envs/caption_scene_dataset_processing_environment.yaml"
    shell:
        r"""
            antsRegistrationSyNQuick.sh \
                -d 3 \
                -f {input.template:q} \
                -m {input.t1w:q} \
                -o {params.prefix:q} \
                -t s \
                -n {threads} \
                -e {params.random_seed}

            MPLBACKEND=Agg python3 workflow/dataset_processing/caption_scene_dataset/scripts/plot_caption_scene_registration_qc.py \
                --warped_t1 {output.warped_t1w:q} \
                --template {input.template:q} \
                --subject {wildcards.subject:q} \
                --output {output.qc:q}
        """

rule compute_caption_scene_sampling_coordinates:
    # for every atlas voxel in a parcel, the native BOLD voxel coordinate to sample
    input:
        bold_files = lambda wildcards: CAPTION_SCENE_BOLD_BY_SUBJECT[wildcards.subject], 
        affine = f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_0GenericAffine.mat", 
        warp = f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_1Warp.nii.gz"
    output:
        sampling_coordinates = f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{{subject}}_sampling_coordinates.npz"
    params:
        n_rois = config["atlas"]["n_rois"], 
        yeo_networks = config["atlas"]["yeo_networks"], 
        atlas_dir = config["atlas"]["atlas_dir"]
    conda:
        "envs/caption_scene_dataset_processing_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/compute_caption_scene_sampling_coordinates.py \
                --bold_files {input.bold_files:q} \
                --affine {input.affine:q} \
                --warp {input.warp:q} \
                --n_rois {params.n_rois} \
                --yeo_networks {params.yeo_networks} \
                --atlas_dir {params.atlas_dir:q} \
                --output {output.sampling_coordinates:q}
        """

rule extract_caption_scene_run_parcels:
    # warps one run to MNI in memory, averages it per parcel and writes one parcel file per
    # event window; no cropped BOLD volume is written
    input:
        run_manifest_dir = CAPTION_SCENE_RUN_MANIFEST_DIR, 
        bold = lambda wildcards: CAPTION_SCENE_BOLD_BY_KEY[wildcards.run_key], 
        sampling_coordinates = lambda wildcards: f"{CAPTION_SCENE_REGISTRATION_DIR}/sub-{CAPTION_SCENE_SUBJECT_BY_KEY[wildcards.run_key]}_sampling_coordinates.npz"
    output:
        run_parcels_done = touch(CAPTION_SCENE_RUN_PARCELS_DONE)
    params:
        run_manifest = lambda wildcards: f"{CAPTION_SCENE_RUN_MANIFEST_DIR}/{wildcards.run_key}.tsv", 
        n_rois = config["atlas"]["n_rois"], 
        output_root = CAPTION_SCENE_PROCESSING_OUTPUT_DIR
    conda:
        "envs/caption_scene_dataset_processing_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/extract_caption_scene_parcels.py \
                --run_manifest {params.run_manifest:q} \
                --bold {input.bold:q} \
                --sampling_coordinates {input.sampling_coordinates:q} \
                --output_root {params.output_root:q} \
                --n_rois {params.n_rois}
        """

rule extract_caption_scene_parcels:
    input:
        run_parcels_done = caption_scene_run_parcel_flags
    output:
        parcels_done = touch(CAPTION_SCENE_PARCELS_DONE)

def caption_scene_stimulus_rows(wildcards):
    checkpoint_output = checkpoints.make_caption_scene_manifest.get().output.manifest
    df = read_manifest(checkpoint_output)

    return df[df["stimulus_id"] == wildcards.stimulus_id]

def caption_scene_parcel_subjects(wildcards):
    return caption_scene_stimulus_rows(wildcards)["subject"].tolist()

def caption_scene_parcel_path(row):
    return str(
        Path(CAPTION_SCENE_PROCESSING_OUTPUT_DIR)
        /"parcels"
        /f"task-{row.stimulus_id}"
        /(
            f"sub-{row.subject}_ses-{row.session}_run-{row.run}_"
            f"task-{row.stimulus_id}_event-{row.event_index}_parcel_ts.npy"
        )
    )

def caption_scene_parcel_paths(wildcards):
    rows = caption_scene_stimulus_rows(wildcards)
    parcel_paths = [caption_scene_parcel_path(row) for row in rows.itertuples(index = False)]

    if len(parcel_paths) < 2:
        raise ValueError(f"Stimulus {wildcards.stimulus_id} has only {len(parcel_paths)} parcel time-series files in the manifest")

    return parcel_paths

rule write_caption_scene_isc_manifest:
    # one row per parcel file of every stimulus, as the other datasets' ISC manifests; read by
    # the ISC reliability rule
    input:
        manifest = CAPTION_SCENE_MANIFEST
    output:
        isc_manifest = CAPTION_SCENE_ISC_MANIFEST
    params:
        code = code_version(read_manifest, caption_scene_parcel_path)
    run:
        events = read_manifest(input.manifest)
        isc_manifest = pd.DataFrame(
            {
                "stimulus_id": events["stimulus_id"], 
                "subject": events["subject"], 
                "parcel_ts": [caption_scene_parcel_path(row) for row in events.itertuples(index = False)], 
            }
        )
        isc_manifest.to_csv(output.isc_manifest, sep = "\t", index = False)

rule compute_caption_scene_isc:
    input:
        parcels_done = CAPTION_SCENE_PARCELS_DONE
    output:
        isc_npy = f"{CAPTION_SCENE_ISC_DIR}/task-{{stimulus_id}}_isc_mean.npy"
    params:
        parcel_ts = caption_scene_parcel_paths, 
        subjects = caption_scene_parcel_subjects, 
        n_rois = config["atlas"]["n_rois"]
    conda:
        "envs/caption_scene_dataset_processing_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/compute_caption_scene_isc.py \
                --parcel_ts {params.parcel_ts:q} \
                --subjects {params.subjects:q} \
                --isc_npy {output.isc_npy:q} \
                --n_rois {params.n_rois}
        """

