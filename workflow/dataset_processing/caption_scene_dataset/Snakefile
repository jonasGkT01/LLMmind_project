import re
from pathlib import Path
from glob import glob

import pandas as pd

CAPTION_SCENE_INTERMEDIATE_DIR = "results/mind/caption_scene/intermediate_files"
CAPTION_SCENE_PROCESSING_OUTPUT_DIR = config["caption_scene"]["processing_output_dir"]
CAPTION_SCENE_ISC_DIR = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/isc"

CAPTION_SCENE_BOLD_GLOB = config["caption_scene"]["bold_glob"]
CAPTION_SCENE_MANIFEST = f"{CAPTION_SCENE_INTERMEDIATE_DIR}/manifest/csd_events_manifest.tsv"
CAPTION_SCENE_RUN_MANIFEST_DIR = f"{CAPTION_SCENE_INTERMEDIATE_DIR}/manifest/by_run"
CAPTION_SCENE_RUN_MANIFEST_INDEX = f"{CAPTION_SCENE_INTERMEDIATE_DIR}/manifest/by_run_manifest_index.tsv"

CAPTION_SCENE_PARCELS_DONE = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/manifests/.parcels_done"
CAPTION_SCENE_ISC_DONE = f"{CAPTION_SCENE_PROCESSING_OUTPUT_DIR}/manifests/.isc_done"

CAPTION_SCENE_IMAGE_CAPTION_TSV = "resources/datasets/caption_scene_dataset/V1/stimuli/COCO_CN/Image_caption_pairs.tsv"
CAPTION_SCENE_STIMULI_READY = config["caption_scene"]["stimuli_ready"]

CAPTION_SCENE_EXCLUDED_STIMULI = config["caption_scene"]["excluded_stimuli"]

def caption_scene_parse_bold_path(path):
    name = Path(path).name

    pattern = (
        r"sub-(?P<subject>[^_]+)"
        r"_ses-(?P<session>[^_]+)"
        r"_task-CSD"
        r"_run-(?P<run>[^.]+)"
        r"\.nii\.gz$"
    )

    match = re.match(pattern, name)

    if match is None:
        raise ValueError(f"Could not parse subject/session/run from BOLD file: {path}.")

    return match.groupdict()

def caption_scene_normalize_int_string(value):
    return str(int(value))

def caption_scene_sample_key(subject, session, run):
    return f"sub-{subject}_ses-{session}_run-{run}"

def caption_scene_run_table_path(subject, run):
    subject_int = caption_scene_normalize_int_string(subject)
    run_int = caption_scene_normalize_int_string(run)

    return str(
        Path("resources/datasets/caption_scene_dataset/V1/stimuli/CSD")
        / f"sub-{subject}"
        / f"subject{subject_int}_run{run_int}.txt"
    )

CAPTION_SCENE_BOLD_FILES = sorted(glob(CAPTION_SCENE_BOLD_GLOB))

if len(CAPTION_SCENE_BOLD_FILES) == 0:
    raise ValueError(f"No BOLD files found with glob: {CAPTION_SCENE_BOLD_GLOB}")

CAPTION_SCENE_RUNS = []
CAPTION_SCENE_BOLD_BY_KEY = {}
CAPTION_SCENE_RUN_TABLE_BY_KEY = {}

for bold_file in CAPTION_SCENE_BOLD_FILES:
    fields = caption_scene_parse_bold_path(bold_file)

    subject = fields["subject"]
    session = fields["session"]
    run = fields["run"]

    key = caption_scene_sample_key(subject, session, run)

    if key in CAPTION_SCENE_BOLD_BY_KEY:
        raise ValueError(f"Duplicate BOLD key found: {key}")

    run_table = caption_scene_run_table_path(subject, run)

    if not Path(run_table).exists():
        raise FileNotFoundError(f"Missing run table for {key}: {run_table}.")

    CAPTION_SCENE_BOLD_BY_KEY[key] = bold_file
    CAPTION_SCENE_RUN_TABLE_BY_KEY[key] = run_table

    CAPTION_SCENE_RUNS.append(
        {
            "key": key,
            "subject": subject,
            "session": session,
            "run": run,
            "bold": bold_file,
            "run_table": run_table,
        }
    )

CAPTION_SCENE_RUN_KEYS = [x["key"] for x in CAPTION_SCENE_RUNS]
CAPTION_SCENE_RUN_TABLES = [x["run_table"] for x in CAPTION_SCENE_RUNS]

def caption_scene_split_done_files(wildcards):
    checkpoint_output = checkpoints.make_caption_scene_manifest.get().output.run_manifest_index
    df = pd.read_csv(checkpoint_output, sep="\t")

    run_keys = sorted(df["run_key"].dropna().astype(str).unique().tolist())

    split_done_files = [
        f"{CAPTION_SCENE_INTERMEDIATE_DIR}/single_stimulus_bold/split_done/{run_key}.done"
        for run_key in run_keys
    ]

    return split_done_files

def read_manifest(path=CAPTION_SCENE_MANIFEST):
    df = pd.read_csv(path, sep="\t")

    for column in [
        "subject",
        "session",
        "run",
        "event_index",
        "stimulus_id",
        "output_bold",
    ]:
        if column in df.columns:
            df[column] = df[column].astype(str)

    return df

def caption_scene_all_isc_outputs(wildcards):
    checkpoint_output = checkpoints.make_caption_scene_manifest.get().output.manifest
    df = read_manifest(checkpoint_output)

    stimuli = sorted(df["stimulus_id"].dropna().unique().tolist())

    isc_npy_files = [
        f"{CAPTION_SCENE_ISC_DIR}/task-{stimulus_id}_isc_mean.npy"
        for stimulus_id in stimuli
    ]

    return isc_npy_files

rule all_caption_scene_dataset:
    input:
        caption_scene_all_isc_outputs,
        CAPTION_SCENE_ISC_DONE,
        CAPTION_SCENE_STIMULI_READY,
        CAPTION_SCENE_EXCLUDED_STIMULI

rule finish_caption_scene_isc:
    input:
        caption_scene_all_isc_outputs
    output:
        touch(CAPTION_SCENE_ISC_DONE)

checkpoint make_caption_scene_manifest:
    input:
        bold_files=CAPTION_SCENE_BOLD_FILES,
        run_tables=CAPTION_SCENE_RUN_TABLES
    output:
        singleton_stimuli=CAPTION_SCENE_EXCLUDED_STIMULI,
        manifest=CAPTION_SCENE_MANIFEST,
        run_manifest_dir=directory(CAPTION_SCENE_RUN_MANIFEST_DIR),
        run_manifest_index=CAPTION_SCENE_RUN_MANIFEST_INDEX
    params:
        output_root=CAPTION_SCENE_INTERMEDIATE_DIR,
        tr=config["caption_scene"]["tr"],
        event_duration_s=config["caption_scene"]["event_duration_s"],
        onset_shift_s=config["caption_scene"]["onset_shift_s"],
        run_table_encoding=config["caption_scene"].get("run_table_encoding", "gbk"),
    conda:
        "envs/make_caption_scene_manifest_environment.yaml"
    shell:
        r"""
            python workflow/dataset_processing/caption_scene_dataset/scripts/make_caption_scene_manifest.py \
                --bold_files {input.bold_files:q} \
                --run_tables {input.run_tables:q} \
                --output_singleton_stimuli {output.singleton_stimuli:q} \
                --output_manifest {output.manifest:q} \
                --output_run_manifest_dir {output.run_manifest_dir:q} \
                --output_run_manifest_index {output.run_manifest_index:q} \
                --output_root {params.output_root:q} \
                --tr {params.tr} \
                --event_duration_s {params.event_duration_s} \
                --onset_shift_s {params.onset_shift_s} \
                --run_table_encoding {params.run_table_encoding:q}
        """

rule split_caption_scene_bold_by_run_manifest:
    input:
        manifest=CAPTION_SCENE_MANIFEST,
        run_manifest_dir=CAPTION_SCENE_RUN_MANIFEST_DIR
    output:
        done=f"{CAPTION_SCENE_INTERMEDIATE_DIR}/single_stimulus_bold/split_done/{{run_key}}.done"
    params:
        run_manifest=lambda wildcards: f"{CAPTION_SCENE_RUN_MANIFEST_DIR}/{wildcards.run_key}.tsv"
    conda:
        "envs/split_caption_scene_bold_by_run_manifest_environment.yaml"
    shell:
        r"""
            python workflow/dataset_processing/caption_scene_dataset/scripts/split_caption_scene_bold_by_run_manifest.py \
                --manifest {params.run_manifest:q}

            touch {output.done}
        """

def caption_scene_parcel_outputs(wildcards):
    checkpoint_output = checkpoints.make_caption_scene_manifest.get().output.manifest
    df = read_manifest(checkpoint_output)

    rows = df[df["stimulus_id"] == wildcards.stimulus_id]

    return [
        str(
            Path(CAPTION_SCENE_PROCESSING_OUTPUT_DIR)
            / "parcels"
            / f"task-{row.stimulus_id}"
            / (
                f"sub-{row.subject}_ses-{row.session}_run-{row.run}_"
                f"task-{row.stimulus_id}_event-{row.event_index}_parcel_ts.npy"
            )
        )
        for row in rows.itertuples(index=False)
    ]

rule extract_caption_scene_parcels:
    input:
        manifest=CAPTION_SCENE_MANIFEST,
        split_done=caption_scene_split_done_files
    output:
        touch(CAPTION_SCENE_PARCELS_DONE)
    params:
        n_rois=config["atlas"]["n_rois"],
        yeo_networks=config["atlas"]["yeo_networks"],
        atlas_dir=config["atlas"]["atlas_dir"],
        output_root=CAPTION_SCENE_PROCESSING_OUTPUT_DIR
    conda:
        "envs/extract_caption_scene_parcels_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/extract_caption_scene_parcels.py \
                --manifest {input.manifest:q} \
                --output_root {params.output_root:q} \
                --n_rois {params.n_rois} \
                --yeo_networks {params.yeo_networks} \
                --atlas_dir {params.atlas_dir:q}
        """

rule compute_caption_scene_isc:
    input:
        CAPTION_SCENE_PARCELS_DONE,
        parcel_ts=caption_scene_parcel_outputs
    output:
        isc_npy=f"{CAPTION_SCENE_ISC_DIR}/task-{{stimulus_id}}_isc_mean.npy",
        isc_nii=f"{CAPTION_SCENE_ISC_DIR}/task-{{stimulus_id}}_isc_mean.nii.gz"
    params:
        n_rois=config["atlas"]["n_rois"],
        yeo_networks=config["atlas"]["yeo_networks"],
        atlas_dir=config["atlas"]["atlas_dir"]
    conda:
        "envs/compute_caption_scene_isc_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/compute_caption_scene_isc.py \
                --parcel_ts {input.parcel_ts:q} \
                --isc_npy {output.isc_npy:q} \
                --isc_nii {output.isc_nii:q} \
                --n_rois {params.n_rois} \
                --yeo_networks {params.yeo_networks} \
                --atlas_dir {params.atlas_dir:q}
        """

rule write_caption_scene_stimuli_transcripts:
    input:
        image_caption_table=CAPTION_SCENE_IMAGE_CAPTION_TSV,
        manifest=CAPTION_SCENE_MANIFEST
    output:
        stimuli_dir=directory(config["caption_scene"]["stimuli_dir"]["language"]),
        transcripts_done=touch(CAPTION_SCENE_STIMULI_READY)
    conda:
        "envs/write_caption_scene_stimuli_transcripts_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/caption_scene_dataset/scripts/write_caption_scene_stimuli_transcripts.py \
                --image_caption_table {input.image_caption_table:q} \
                --manifest {input.manifest:q} \
                --output_dir {output.stimuli_dir:q}
        """