import pandas as pd

from pathlib import Path

NSD_DATASET_DIRECTORY = config["nsd_data"]["dataset_dir"]
NSD_PROCESSING_OUTPUT_DIRECTORY = config["nsd_data"]["processing_output_dir"]
NSD_SUBJECTS = list(range(1, int(config["nsd_data"]["subjects"]) + 1))

NSD_MANIFEST_DIRECTORY = f"{NSD_PROCESSING_OUTPUT_DIRECTORY}/manifests"
NSD_OCCURRENCE_MANIFEST = f"{NSD_MANIFEST_DIRECTORY}/nsd_occurrence_manifest.tsv"
NSD_STIMULUS_MANIFEST = f"{NSD_MANIFEST_DIRECTORY}/nsd_stimulus_manifest.tsv"
NSD_PARCEL_MANIFEST = f"{NSD_MANIFEST_DIRECTORY}/parcel_extraction_manifest.tsv"
NSD_ISC_MANIFEST = f"{NSD_MANIFEST_DIRECTORY}/isc_manifest.tsv"
NSD_RUN_LENGTH_QUALITY_CONTROL = f"{NSD_MANIFEST_DIRECTORY}/run_length_qc.tsv"
NSD_MANIFEST_METADATA = f"{NSD_MANIFEST_DIRECTORY}/manifest_metadata.json"

NSD_BOLD_DONE = f"{NSD_MANIFEST_DIRECTORY}/.bold_done"
NSD_PARCELS_DONE = f"{NSD_MANIFEST_DIRECTORY}/.parcels_done"
NSD_ISC_DONE = f"{NSD_MANIFEST_DIRECTORY}/.isc_done"

NSD_ISC_DIRECTORY = f"{NSD_PROCESSING_OUTPUT_DIRECTORY}/isc"

NSD_STIMULI_READY = config["nsd_data"]["stimuli_ready"]
NSD_EXCLUDED_STIMULI = config["nsd_data"]["excluded_stimuli"]

def nsd_parcel_time_series_output(subject, stimulus_identifier, repetition):
    return f"{NSD_PROCESSING_OUTPUT_DIRECTORY}/parcels/task-{stimulus_identifier}/sub-{int(subject):02d}_rep-{int(repetition):02d}_task-{stimulus_identifier}_parcel_ts.npy"

def write_nsd_parcel_manifest(occurrence_manifest_path, output_manifest_path):
    occurrence_manifest = pd.read_csv(occurrence_manifest_path, sep="\t")
    required_columns = {"subject", "stimulus_id", "repetition", "output_bold"}
    missing_columns = required_columns - set(occurrence_manifest.columns)

    if missing_columns:
        raise ValueError(f"Occurrence manifest is missing columns: {sorted(missing_columns)}")

    unique_samples = occurrence_manifest[["subject", "stimulus_id", "repetition", "output_bold"]].drop_duplicates().sort_values(["stimulus_id", "subject", "repetition"])
    sample_counts = unique_samples.groupby(["subject", "stimulus_id", "repetition"]).size()
    invalid_samples = sample_counts[sample_counts != 1]

    if not invalid_samples.empty:
        raise ValueError("Found subject/stimulus/repetition triples with multiple BOLD outputs:\n" + invalid_samples.to_string())

    output_manifest_path = Path(output_manifest_path)
    output_manifest_path.parent.mkdir(parents=True, exist_ok=True)

    with output_manifest_path.open("w") as output_manifest_file:
        output_manifest_file.write("subject\tstimulus_id\trepetition\tbold_file\tparcel_time_series\n")

        for sample in unique_samples.itertuples(index=False):
            parcel_time_series_file = nsd_parcel_time_series_output(sample.subject, sample.stimulus_id, sample.repetition)
            output_manifest_file.write(f"{int(sample.subject)}\t{sample.stimulus_id}\t{int(sample.repetition)}\t{sample.output_bold}\t{parcel_time_series_file}\n")

def write_nsd_isc_manifest(parcel_manifest_path, output_manifest_path):
    parcel_manifest = pd.read_csv(parcel_manifest_path, sep="\t")
    required_columns = {"subject", "stimulus_id", "repetition", "parcel_time_series"}
    missing_columns = required_columns - set(parcel_manifest.columns)

    if missing_columns:
        raise ValueError(f"Parcel manifest is missing columns: {sorted(missing_columns)}")

    output_manifest_path = Path(output_manifest_path)
    output_manifest_path.parent.mkdir(parents=True, exist_ok=True)

    with output_manifest_path.open("w") as output_manifest_file:
        output_manifest_file.write("stimulus_id\tsubject\trepetition\tparcel_time_series\tisc_numpy_file\tisc_nifti_file\n")

        for stimulus_identifier, stimulus_manifest in parcel_manifest.groupby("stimulus_id", sort=True):
            isc_numpy_file = f"{NSD_ISC_DIRECTORY}/task-{stimulus_identifier}_isc_mean.npy"
            isc_nifti_file = f"{NSD_ISC_DIRECTORY}/task-{stimulus_identifier}_isc_mean.nii.gz"
            stimulus_manifest = stimulus_manifest.sort_values(["subject", "repetition"])

            for sample in stimulus_manifest.itertuples(index=False):
                output_manifest_file.write(
                    f"{stimulus_identifier}\t{int(sample.subject)}\t{int(sample.repetition)}\t{sample.parcel_time_series}\t{isc_numpy_file}\t{isc_nifti_file}\n"
                )

rule all_nsd_data_dataset:
    input:
        NSD_ISC_DONE,
        NSD_STIMULI_READY,
        NSD_EXCLUDED_STIMULI

rule make_nsd_manifest:
    output:
        occurrence_manifest=NSD_OCCURRENCE_MANIFEST,
        stimulus_manifest=NSD_STIMULUS_MANIFEST,
        excluded_stimuli=NSD_EXCLUDED_STIMULI,
        run_length_quality_control=NSD_RUN_LENGTH_QUALITY_CONTROL,
        metadata=NSD_MANIFEST_METADATA
    params:
        dataset_dir=NSD_DATASET_DIRECTORY,
        output_root=NSD_PROCESSING_OUTPUT_DIRECTORY,
        subjects=" ".join(str(subject) for subject in NSD_SUBJECTS),
        tr=config["nsd_data"]["tr"],
        event_duration_s=config["nsd_data"]["event_duration_s"],
        onset_shift_volumes=config["nsd_data"]["onset_shift_volumes"]
    conda:
        "envs/nsd_data_dataset_processing_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/nsd_data_dataset/scripts/make_nsd_manifest.py \
                --dataset_dir {params.dataset_dir:q} \
                --output_root {params.output_root:q} \
                --subjects {params.subjects} \
                --tr {params.tr} \
                --event_duration_s {params.event_duration_s} \
                --onset_shift_volumes {params.onset_shift_volumes} \
                --output_manifest {output.occurrence_manifest:q} \
                --output_stimulus_manifest {output.stimulus_manifest:q} \
                --output_excluded_stimuli {output.excluded_stimuli:q} \
                --output_run_length_qc {output.run_length_quality_control:q} \
                --output_metadata {output.metadata:q}
        """

rule write_nsd_parcel_manifest:
    input:
        occurrence_manifest=NSD_OCCURRENCE_MANIFEST
    output:
        manifest=NSD_PARCEL_MANIFEST
    run:
        write_nsd_parcel_manifest(input.occurrence_manifest, output.manifest)

rule assemble_nsd_bold:
    input:
        manifest=NSD_OCCURRENCE_MANIFEST
    output:
        touch(NSD_BOLD_DONE)
    params:
        dataset_dir=NSD_DATASET_DIRECTORY,
        interpolation=config["nsd_data"]["map_interpolation"]
    conda:
        "envs/nsd_data_dataset_processing_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/nsd_data_dataset/scripts/assemble_nsd_bold.py \
                --manifest {input.manifest:q} \
                --dataset_dir {params.dataset_dir:q} \
                --interpolation {params.interpolation:q}
        """

rule extract_nsd_parcels:
    input:
        manifest=NSD_PARCEL_MANIFEST,
        bold_done=NSD_BOLD_DONE
    output:
        touch(NSD_PARCELS_DONE)
    params:
        number_of_regions=config["atlas"]["n_rois"],
        number_of_yeo_networks=config["atlas"]["yeo_networks"],
        atlas_dir=config["atlas"]["atlas_dir"]
    conda:
        "envs/nsd_data_dataset_processing_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/nsd_data_dataset/scripts/extract_nsd_parcels.py \
                --manifest {input.manifest:q} \
                --number_of_regions {params.number_of_regions} \
                --number_of_yeo_networks {params.number_of_yeo_networks} \
                --atlas_dir {params.atlas_dir:q}
        """

rule write_nsd_isc_manifest:
    input:
        parcel_manifest=NSD_PARCEL_MANIFEST
    output:
        manifest=NSD_ISC_MANIFEST
    run:
        write_nsd_isc_manifest(input.parcel_manifest, output.manifest)

rule compute_nsd_isc:
    input:
        manifest=NSD_ISC_MANIFEST,
        parcels_done=NSD_PARCELS_DONE
    output:
        isc_dir=directory(NSD_ISC_DIRECTORY),
        done=touch(NSD_ISC_DONE)
    params:
        number_of_regions=config["atlas"]["n_rois"],
        number_of_yeo_networks=config["atlas"]["yeo_networks"],
        atlas_dir=config["atlas"]["atlas_dir"]
    conda:
        "envs/nsd_data_dataset_processing_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/nsd_data_dataset/scripts/compute_nsd_isc.py \
                --manifest {input.manifest:q} \
                --number_of_regions {params.number_of_regions} \
                --number_of_yeo_networks {params.number_of_yeo_networks} \
                --atlas_dir {params.atlas_dir:q}
        """

rule export_nsd_stimuli:
    input:
        stimulus_manifest=NSD_STIMULUS_MANIFEST
    output:
        stimuli_dir=directory(config["nsd_data"]["stimuli_dir"]["vision"]),
        ready=touch(NSD_STIMULI_READY)
    params:
        stimuli_hdf5=config["nsd_data"]["stimuli_hdf5"]
    conda:
        "envs/nsd_data_dataset_processing_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/nsd_data_dataset/scripts/export_nsd_stimuli.py \
                --stimulus_manifest {input.stimulus_manifest:q} \
                --stimuli_hdf5 {params.stimuli_hdf5:q} \
                --output_dir {output.stimuli_dir:q}
        """