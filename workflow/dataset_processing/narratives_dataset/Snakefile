import json
import numpy as np

from pathlib import Path
from itertools import product

NARRATIVES_SUBJECTS = [f"{i:03d}" for i in range(1, config["narratives"]["subjects"] + 1)]
NARRATIVES_PROCESSING_OUTPUT_DIR = config["narratives"]["processing_output_dir"]

NARRATIVES_PARCEL_MANIFEST = f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/manifests/parcel_extraction_manifest.tsv"
NARRATIVES_ISC_MANIFEST = f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/manifests/isc_manifest.tsv"

NARRATIVES_STIMULI_TRANSCRIPTS_DONE = config["narratives"]["stimuli_transcripts_done"]

def narratives_task_is_excluded(task):
    return task in config["narratives"]["problematic_subtasks"]

VALID_NARRATIVES_TASKS = [task for task in config["narratives"]["tasks"] if not narratives_task_is_excluded(task)]

def narratives_run_label(run_tag):
    return "norun" if run_tag == "" else run_tag.replace("_", "")

with open(config["narratives"]["scans_to_be_excluded"]) as f:
    NARRATIVES_SCAN_EXCLUDE = json.load(f)

def narratives_excluded_scan_prefixes(task):
    task_dict = NARRATIVES_SCAN_EXCLUDE.get(task, {})
    return {
        prefix
        for scans in task_dict.values()
        for prefix in scans
    }

def narratives_scan_prefix(subject, task, run_tag):
    prefix = f"sub-{subject}_task-{task}"
    if run_tag != "":
        prefix += run_tag
    return prefix

def narratives_excluded(subject, task, run_tag):
    return narratives_scan_prefix(subject, task, run_tag) in narratives_excluded_scan_prefixes(task)

def narratives_parcel_output(c):
    return f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/parcels/{c['task']}/sub-{c['subject']}_task-{c['task']}_{c['run_label']}_space-{c['space']}_res-{c['resolution']}_desc-{c['descriptor']}_parcel_ts.npy"

def narratives_write_length_check_json(task, parcel_files, output_json):
    parcel_files = [Path(p) for p in parcel_files]
    output_json = Path(output_json)
    output_json.parent.mkdir(parents=True, exist_ok=True)

    lengths = {}
    unreadable_files = {}
    malformed_files = {}

    for f in parcel_files:
        scan_id = f.stem

        try:
            arr = np.load(f, mmap_mode="r")
        except Exception as e:
            unreadable_files[scan_id] = str(e)
            continue

        if arr.ndim < 1:
            malformed_files[scan_id] = f"Expected at least one dimension, got shape {arr.shape}"
            continue

        lengths[scan_id] = int(arr.shape[0])

    unique_lengths = sorted(set(lengths.values()))

    if len(parcel_files) == 0:
        valid = False
        reason = "No parcel files were provided."
    elif unreadable_files:
        valid = False
        reason = "One or more parcel files could not be read."
    elif malformed_files:
        valid = False
        reason = "One or more parcel files had an invalid shape."
    elif len(lengths) == 0:
        valid = False
        reason = "No valid parcel files were available after loading."
    elif len(unique_lengths) != 1:
        valid = False
        reason = "Mismatched parcel time lengths across scans."
    else:
        valid = True
        reason = "All parcel timeseries have identical length."

    payload = {
        "task": task,
        "valid": valid,
        "reason": reason,
        "n_input_files": len(parcel_files),
        "n_valid_files": len(lengths),
        "common_length": unique_lengths[0] if valid else None,
        "unique_lengths": unique_lengths,
        "time_lengths": lengths,
        "unreadable_files": unreadable_files,
        "malformed_files": malformed_files,
    }

    with open(output_json, "w") as f:
        json.dump(payload, f, indent=2, sort_keys=True)

    return valid

NARRATIVES_BOLD_FILES = []
for subject, task, run_tag, space, resolution, descriptor in product(
    NARRATIVES_SUBJECTS,
    config["narratives"]["tasks"],
    config["narratives"]["run_tags"],
    config["narratives"]["spaces"],
    config["narratives"]["resolutions"],
    config["narratives"]["descriptors"],
):
    if narratives_excluded(subject, task, run_tag):
        continue

    bold_file = config["narratives"]["bold_pattern"].format(
        subject=subject,
        task=task,
        run_tag=run_tag,
        space=space,
        resolution=resolution,
        descriptor=descriptor,
    )

    if Path(bold_file).exists():
        NARRATIVES_BOLD_FILES.append({
            "subject": subject,
            "task": task,
            "run_tag": run_tag,
            "run_label": narratives_run_label(run_tag),
            "space": space,
            "resolution": resolution,
            "descriptor": descriptor,
            "bold_file": bold_file,
        })

NARRATIVES_TASK_GROUPS = {}
for c in NARRATIVES_BOLD_FILES:
    if c["task"] not in VALID_NARRATIVES_TASKS:
        continue

    NARRATIVES_TASK_GROUPS.setdefault(c["task"], []).append(c)

def parcel_outputs_for_task(task):
    return [
        narratives_parcel_output(c)
        for c in NARRATIVES_TASK_GROUPS[task]
    ]

NARRATIVES_PARCEL_OUTPUTS = [
    narratives_parcel_output(c)
    for task in NARRATIVES_TASK_GROUPS
    for c in NARRATIVES_TASK_GROUPS[task]
]

def write_narratives_parcel_manifest(output_tsv):
    output_tsv = Path(output_tsv)
    output_tsv.parent.mkdir(parents=True, exist_ok=True)

    with open(output_tsv, "w") as f:
        f.write("bold_file\tparcel_ts\n")

        for task in NARRATIVES_TASK_GROUPS:
            for c in NARRATIVES_TASK_GROUPS[task]:
                f.write(f"{c['bold_file']}\t{narratives_parcel_output(c)}\n")

def write_narratives_isc_manifest(output_tsv):
    output_tsv = Path(output_tsv)
    output_tsv.parent.mkdir(parents=True, exist_ok=True)

    with open(output_tsv, "w") as f:
        f.write("task\tparcel_ts\tisc_npy\tisc_nii\n")

        for task in NARRATIVES_TASK_GROUPS:
            isc_npy = f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/isc/task-{task}_isc_mean.npy"
            isc_nii = f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/isc/task-{task}_isc_mean.nii.gz"

            for parcel_ts in parcel_outputs_for_task(task):
                f.write(f"{task}\t{parcel_ts}\t{isc_npy}\t{isc_nii}\n")

excluded_scans_for_task = []
for task in config["narratives"]["tasks"]:
    if task not in VALID_NARRATIVES_TASKS:
#        print(f"Skipping length check for excluded task {task}. See {config['narratives']['excluded_scans_for_task']} for details.")
        if task in config["narratives"]["schema_subtasks"]:
            reason = "Excluded because it is a schema subtask."
        elif task in config["narratives"]["notthefall_variants"]:
            reason = "Excluded because it is a notthefall variant."
        else:
            reason = "Excluded for unspecified reason."

        for c in NARRATIVES_BOLD_FILES:
            if c["task"] == task:
                excluded_scans_for_task.append({
                    "task": task,
                    "reason": reason,
                    "bold_file": c["bold_file"],
                })
        continue

    narratives_write_length_check_json(task, parcel_outputs_for_task(task), f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/qc/task-{task}_length_check.json")
#    if not narratives_write_length_check_json(task, parcel_outputs_for_task(task), f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/qc/task-{task}_length_check.json"):
#        print(f"Warning: Length check failed for task {task}. See {NARRATIVES_PROCESSING_OUTPUT_DIR}/qc/task-{task}_length_check.json for details.")

excluded_scans_for_task_path = Path(config["narratives"]["excluded_scans_for_task"])
excluded_scans_for_task_path.parent.mkdir(parents=True, exist_ok=True)

with open(config["narratives"]["excluded_scans_for_task"], "w") as f:
    json.dump(excluded_scans_for_task, f, indent=2, sort_keys=True)

NARRATIVES_ISC_NPY_OUTPUTS = [
    f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/isc/task-{task}_isc_mean.npy"
    for task in NARRATIVES_TASK_GROUPS
]

NARRATIVES_ISC_NII_OUTPUTS = [
    f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/isc/task-{task}_isc_mean.nii.gz"
    for task in NARRATIVES_TASK_GROUPS
]

NARRATIVES_ISC_DONE = f"{NARRATIVES_PROCESSING_OUTPUT_DIR}/manifests/.isc_done"

rule all_narratives_dataset:
    input:
        NARRATIVES_ISC_NPY_OUTPUTS,
        NARRATIVES_ISC_NII_OUTPUTS,
        NARRATIVES_ISC_DONE,
        NARRATIVES_STIMULI_TRANSCRIPTS_DONE

rule mark_narratives_isc_and_stimuli_transcripts_done:
    input:
        NARRATIVES_ISC_NII_OUTPUTS
    output:
        touch(NARRATIVES_ISC_DONE),
        touch(NARRATIVES_STIMULI_TRANSCRIPTS_DONE)

rule write_narratives_parcel_manifest:
    output:
        manifest=NARRATIVES_PARCEL_MANIFEST
    run:
        write_narratives_parcel_manifest(output.manifest)

rule write_narratives_isc_manifest:
    input:
        parcel_manifest=NARRATIVES_PARCEL_MANIFEST
    output:
        manifest=NARRATIVES_ISC_MANIFEST
    run:
        write_narratives_isc_manifest(output.manifest)

rule extract_narratives_parcels:
    input:
        manifest=NARRATIVES_PARCEL_MANIFEST
    output:
        NARRATIVES_PARCEL_OUTPUTS
    params:
        n_rois=config["atlas"]["n_rois"],
        yeo_networks=config["atlas"]["yeo_networks"],
        atlas_dir=config["atlas"]["atlas_dir"]
    conda:
        "envs/extract_narratives_parcels_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/narratives_dataset/scripts/extract_narratives_parcels.py \
                --manifest {input.manifest:q} \
                --n_rois {params.n_rois} \
                --yeo_networks {params.yeo_networks} \
                --atlas_dir {params.atlas_dir:q}
        """

rule compute_narratives_isc:
    input:
        manifest=NARRATIVES_ISC_MANIFEST,
        parcel_ts=NARRATIVES_PARCEL_OUTPUTS
    output:
        isc_npy=NARRATIVES_ISC_NPY_OUTPUTS,
        isc_nii=NARRATIVES_ISC_NII_OUTPUTS
    params:
        n_rois=config["atlas"]["n_rois"],
        yeo_networks=config["atlas"]["yeo_networks"],
        atlas_dir=config["atlas"]["atlas_dir"]
    conda:
        "envs/compute_narratives_isc_environment.yaml"
    shell:
        r"""
            python3 workflow/dataset_processing/narratives_dataset/scripts/compute_narratives_isc.py \
                --manifest {input.manifest:q} \
                --n_rois {params.n_rois} \
                --yeo_networks {params.yeo_networks} \
                --atlas_dir {params.atlas_dir:q}
        """