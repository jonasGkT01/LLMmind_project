rule all_llm_mind_alignment:
    input:
        llm_brain_alignment_scores = [
            f"results/alignment_scores/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_{pair['similarity_type']}-alignment_score_{pair['number_of_neighbours']}NN.parquet"
            for pair in PAIRINGS
        ], 
        llm_brain_p_values = [
            f"results/alignment_scores/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_{method}_{pair['similarity_type']}-alignment_score_{pair['number_of_neighbours']}NN.p_value.tsv"
            for pair in PAIRINGS
            for method in ["empirical", "hypergeometric"]
        ], 
        llm_brain_summary = "results/all_model_brain_alignment_scores.tsv"

rule compute_llm_mind_alignment_score:
    input:
        isc_nearest_neighbours = "results/mind/{dataset}/isc_{similarity_type}_nearest_neighbours.parquet", 
        llm_nearest_neighbours = "results/{stimuli_type}_models/{dataset}/{similarity_type}_nearest_neighbours/{model}_{similarity_type}_nearest_neighbours.parquet"
    output:
        llm_brain_alignment_score = "results/alignment_scores/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-alignment_score_{number_of_neighbours}NN.parquet"
    params:
        number_of_neighbours = lambda wc: wc.number_of_neighbours
    conda:
        "envs/llm_mind_alignment_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_mind_alignment/scripts/compute_llm_mind_alignment_score.py \
                --number_of_neighbours {params.number_of_neighbours} \
                --isc_nearest_neighbours {input.isc_nearest_neighbours:q} \
                --llm_nearest_neighbours {input.llm_nearest_neighbours:q} \
                --alignment_score {output.llm_brain_alignment_score:q}
        """

rule relabel_llm_similarity_and_compute_relabelled_llm_alignment_score:
    # one job per (dataset, model, stimuli_type, similarity_type) covers every configured k for that
    # dataset in a single run (one shared permutation per shuffle, reused across k) instead of one
    # Snakemake job per k independently re-deriving the same permutations. Output is a single combined
    # file — Snakemake rule outputs can't be a function of wildcards the way inputs can — and each
    # consumer reads the k it needs from it (compute_alignment.read_relabelled_alignment_scores)
    input:
        embedding_dataframe = "results/{stimuli_type}_models/{dataset}/embeddings/{model}_embeddings.parquet", 
        isc_nearest_neighbours = "results/mind/{dataset}/isc_{similarity_type}_nearest_neighbours.parquet"
    output:
        relabelled_common_neighbours = "results/alignment_scores/relabelled_common_neighbours/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-relabelled_common_neighbours.parquet"
    params:
        numbers_of_neighbours = lambda wc: dataset_numbers_of_neighbours(wc.dataset), 
        model = lambda wc: wc.model, 
        similarity_type = lambda wc: wc.similarity_type, 
        number_of_relabellings = NUMBER_OF_RELABELLINGS, 
        random_seed = RANDOM_SEED
    conda:
        "envs/llm_mind_alignment_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_mind_alignment/scripts/relabel_llm_similarity_and_compute_relabelled_llm_alignment_score.py \
                --embedding_dataframe {input.embedding_dataframe:q} \
                --isc_nearest_neighbours {input.isc_nearest_neighbours:q} \
                --similarity_type {params.similarity_type:q} \
                --relabelled_common_neighbours {output.relabelled_common_neighbours:q} \
                --number_of_neighbours {params.numbers_of_neighbours} \
                --model {params.model:q} \
                --number_of_relabellings {params.number_of_relabellings} \
                --random_seed {params.random_seed}
        """

rule compute_empirical_p_value:
    input:
        observed_alignment_score = "results/alignment_scores/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-alignment_score_{number_of_neighbours}NN.parquet", 
        relabelled_common_neighbours = "results/alignment_scores/relabelled_common_neighbours/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-relabelled_common_neighbours.parquet"
    output:
        empirical_p_value = "results/alignment_scores/dataset-{dataset}_model-{model}-{stimuli_type}_brain_empirical_{similarity_type}-alignment_score_{number_of_neighbours}NN.p_value.tsv"
    params:
        number_of_neighbours = lambda wc: wc.number_of_neighbours
    conda:
        "envs/llm_mind_alignment_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_mind_alignment/scripts/compute_empirical_p_value.py \
                --observed_alignment_score {input.observed_alignment_score:q} \
                --relabelled_common_neighbours {input.relabelled_common_neighbours:q} \
                --number_of_neighbours {params.number_of_neighbours} > {output.empirical_p_value:q}
        """

rule compute_hypergeometric_p_value:
    input:
        observed_alignment_score = "results/alignment_scores/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-alignment_score_{number_of_neighbours}NN.parquet"
    output:
        hypergeometric_p_value = "results/alignment_scores/dataset-{dataset}_model-{model}-{stimuli_type}_brain_hypergeometric_{similarity_type}-alignment_score_{number_of_neighbours}NN.p_value.tsv"
    params:
        number_of_neighbours = lambda wc: wc.number_of_neighbours
    conda:
        "envs/llm_mind_alignment_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_mind_alignment/scripts/compute_hypergeometric_p_value.py \
                --observed_alignment_score {input.observed_alignment_score:q} \
                --number_of_neighbours {params.number_of_neighbours} > {output.hypergeometric_p_value:q}
        """

AGGREGATE_ALL_P_VALUE_OUTPUTS_SCRIPT = "workflow/llm_mind_alignment/scripts/aggregate_all_p_value_outputs.py"

rule aggregate_all_p_value_outputs:
    input:
        empirical_p_values = [
            f"results/alignment_scores/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_empirical_{pair['similarity_type']}-alignment_score_{pair['number_of_neighbours']}NN.p_value.tsv"
            for pair in PAIRINGS
        ], 
        hypergeometric_p_values = [
            f"results/alignment_scores/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_hypergeometric_{pair['similarity_type']}-alignment_score_{pair['number_of_neighbours']}NN.p_value.tsv"
            for pair in PAIRINGS
        ], 
        # one all-k file per (dataset, model, stimuli type, similarity), serving every k
        relabelled_common_neighbours = list(dict.fromkeys(
            f"results/alignment_scores/relabelled_common_neighbours/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_{pair['similarity_type']}-relabelled_common_neighbours.parquet"
            for pair in PAIRINGS
        ))
    output:
        all_model_brain_alignment_scores_tsv = "results/all_model_brain_alignment_scores.tsv"
    params:
        code = code_version(AGGREGATE_ALL_P_VALUE_OUTPUTS_SCRIPT)
    threads:
        4
    conda:
        "envs/llm_mind_alignment_environment.yaml"
    shell:
        r"""
            python3 {AGGREGATE_ALL_P_VALUE_OUTPUTS_SCRIPT:q} \
                --empirical_p_values {input.empirical_p_values:q} \
                --hypergeometric_p_values {input.hypergeometric_p_values:q} \
                --relabelled_common_neighbours {input.relabelled_common_neighbours:q} \
                --all_model_brain_alignment_scores_tsv {output.all_model_brain_alignment_scores_tsv:q} \
                --threads {threads}
        """
