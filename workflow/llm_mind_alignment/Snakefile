rule all_llm_mind_alignment:
    input:
        [
            f"results/alignment_Scores/{pair['dataset']}_{pair['model']}-{pair['stimuli_type']}_brain_{pair['similarity_type']}-alignment_score_{pair['number_of_neighbours']}NN.parquet"
            for pair in PAIRINGS
        ],
#        [
#            f"results/alignment_summary/{pair['stimuli_type']}_models/{pair['dataset']}/parquet_summary/{pair['similarity_type']}_alignment_summary_{pair['number_of_neighbours']}NN_all_models.parquet"
#            for pair in PAIRINGS
#        ],
#        [
#            f"results/alignment_summary/{pair['stimuli_type']}_models/{pair['dataset']}/tsv_summary/{pair['similarity_type']}_alignment_summary_{pair['number_of_neighbours']}NN_all_models.tsv"
#            for pair in PAIRINGS
#        ]

rule compute_llm_mind_alignment_score:
    input:
        isc_nearest_neighbours="results/mind/{dataset}/isc_{similarity_type}_nearest_neighbours_{number_of_neighbours}NN.parquet",
        llm_nearest_neighnours="results/{stimuli_type}_models/{dataset}/{similarity_type}_nearest_neighbours/{model}_{similarity_type}_nearest_neighbours_{number_of_neighbours}NN.parquet"
    output:
        llm_brain_alignment_score="results/alignment_Scores/{dataset}_{model}-{stimuli_type}_brain_{similarity_type}-alignment_score_{number_of_neighbours}NN.parquet"
    params:
        number_of_neighbours=lambda wc: wc.number_of_neighbours
    conda:
        "envs/compute_llm_mind_alignment_score_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_mind_alignment/scripts/compute_llm_mind_alignment_score.py \
                --number_of_neighbours {params.number_of_neighbours} \
                --isc_nearest_neighbours {input.isc_nearest_neighbours:q} \
                --llm_nearest_neighbours {input.llm_nearest_neighnours:q} \
                --alignment_score {output.llm_brain_alignment_score:q}
        """

rule compute_relabelled_llm_mind_alignment_score:
    input:
        isc_nearest_neighbours="results/mind/{dataset}/isc_{similarity_type}_nearest_neighbours_{number_of_neighbours}NN.parquet",
        relabelled_llm_nearest_neighbours="results/{stimuli_type}_models/{dataset}/relabelled_nearest_neighbours/relabelled_{model}_{similarity_type}_nearest_neighbours_{number_of_neighbours}NN.parquet"
    output:
        relabelled_alignment_score="results/alignment_Scores/{dataset}_{model}-{stimuli_type}_brain_{similarity_type}-relabelled_alignment_score_{number_of_neighbours}NN.parquet"
    params:
        number_of_neighbours=lambda wc: wc.number_of_neighbours,
        model="{model}"
    conda:
        "envs/compute_relabelled_llm_mind_alignment_score_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_mind_alignment/scripts/compute_relabelled_llm_mind_alignment_score.py \
                --number_of_neighbours {params.number_of_neighbours} \
                --model {params.model:q} \
                --relabelled_llm_nearest_neighbours {input.relabelled_llm_nearest_neighbours:q} \
                --isc_nearest_neighbours {input.isc_nearest_neighbours:q} \
                --relabelled_alignment_score {output.relabelled_alignment_score:q}
        """

rule compute_empirical_p_value:
    input:
        observed_alignment_score="results/alignment_Scores/{dataset}_{model}-{stimuli_type}_brain_{similarity_type}-alignment_score_{number_of_neighbours}NN.parquet",
        relabelled_alignment_score="results/alignment_Scores/{dataset}_{model}-{stimuli_type}_brain_relabelled_{similarity_type}-alignment_score_{number_of_neighbours}NN.parquet"
    output:
        empirical_p_value="results/alignment_Scores/{dataset}_{model}-{stimuli_type}_brain_empirical_{similarity_type}-alignment_score_{number_of_neighbours}NN.p_value.tsv"
    conda:
        "envs/compute_empirical_p_value_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_mind_alignment/scripts/compute_empirical_p_value.py \
                --observed_alignment_score {input.observed_alignment_score:q} \
                --relabelled_alignment_score {input.relabelled_alignment_score:q} > {output.empirical_p_value:q}
        """

rule compute_hypergeometric_p_value:
    input:
        observed_alignment_score="results/alignment_Scores/{dataset}_{model}-{stimuli_type}_brain_{similarity_type}-alignment_score_{number_of_neighbours}NN.parquet"
    output:
        hypergeometric_p_value="results/alignment_Scores/{dataset}_{model}-{stimuli_type}_brain_hypergeometric_{similarity_type}-alignment_score_{number_of_neighbours}NN.p_value.tsv"
    params:
        number_of_neighbours=lambda wc: wc.number_of_neighbours
    conda:
        "envs/compute_hypergeometric_p_value_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_mind_alignment/scripts/compute_hypergeometric_p_value.py \
                --observed_alignment_score {input.observed_alignment_score:q} \
                --number_of_neighbours {params.number_of_neighbours} > {output.hypergeometric_p_value:q}
        """

rule reduce:
    input:
        [
            f"results/alignment_Scores/{pair['dataset']}_{pair['model']}-{pair['stimuli_type']}_brain_{method}_{pair['similarity_type']}-alignment_score_{pair['number_of_neighbours']}NN.p_value.tsv"
            for pair in PAIRINGS
            for method in ["empirical", "hypergeometric"]
        ]
    output:
        tsv_summary="results/summary.tsv"
    conda:
        "envs/reduce_environment.yaml"
    shell:
        r"""
            matrix_reduce -t "results/alignment_Scores/*_*-*_*_brain_*-*_alignment_score_*NN.p_value.tsv" > {output.tsv_summary:q}
        """

