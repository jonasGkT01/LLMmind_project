configfile: "config/config.yaml"

shell.prefix(
    'export PYTHONPATH="$PWD/workflow:$PYTHONPATH"; '
)

DATASETS = list(config["datasets"])
MODEL_KEYS = list(config["models"].keys())
SIMILARITY_TYPES = list(config["similarity_types"])

NUMBER_OF_RELABELLINGS = config["number_of_relabellings"]
RANDOM_SEED = config["random_seed"]

def pairings():
    pairs = []

    for dataset in DATASETS:
        numbers_of_neighbours = config[dataset]["number_of_neighbours"]

        # allow both old scalar syntax and new list syntax
        if isinstance(numbers_of_neighbours, int):
            numbers_of_neighbours = [numbers_of_neighbours]

        for number_of_neighbours in numbers_of_neighbours:
            for stimuli_type in list(config[dataset]["stimuli_dir"].keys()):
                for model in MODEL_KEYS:
                    if config["models"][model]["modality"] in [stimuli_type, "multimodal"]:
                        for similarity_type in SIMILARITY_TYPES:
                            pairs.append(
                                {
                                    "dataset": dataset,
                                    "number_of_neighbours": number_of_neighbours,
                                    "stimuli_type": stimuli_type,
                                    "model": model,
                                    "similarity_type": similarity_type,
                                }
                            )

    return pairs

PAIRINGS = pairings()

from itertools import combinations, product

def llm_llm_pairings():
    llm_llm_pairs = []

    for dataset in DATASETS:
        numbers_of_neighbours = config[dataset]["number_of_neighbours"]

        # allow both old scalar syntax and new list syntax
        if isinstance(numbers_of_neighbours, int):
            numbers_of_neighbours = [numbers_of_neighbours]

        available_modalities = list(config[dataset]["stimuli_dir"].keys())

        for number_of_neighbours in numbers_of_neighbours:
            compatible_models = [
                model
                for model in MODEL_KEYS
                if config["models"][model]["modality"] in set(available_modalities + ["multimodal"])
            ]

            for model_1, model_2 in combinations(compatible_models, 2):
                for modality_1, modality_2 in product(available_modalities, repeat=2):
                    if config["models"][model_1]["modality"] in [modality_1, "multimodal"] and config["models"][model_2]["modality"] in [modality_2, "multimodal"]:
                        for similarity_type in SIMILARITY_TYPES:
                            llm_llm_pairs.append(
                                {
                                    "dataset": dataset,
                                    "number_of_neighbours": number_of_neighbours,
                                    "model_1": model_1,
                                    "stimuli_type_1": modality_1,
                                    "model_2": model_2,
                                    "stimuli_type_2": modality_2,
                                    "similarity_type": similarity_type,
                                }
                            )

    return llm_llm_pairs

LLM_LLM_PAIRINGS = llm_llm_pairings()

HEATMAP_PAIRINGS = [
    {
        "dataset": dataset,
        "similarity_type": similarity_type,
        "number_of_neighbours": number_of_neighbours,
    }
    for dataset in DATASETS
    for similarity_type in SIMILARITY_TYPES
    for number_of_neighbours in (
        config[dataset]["number_of_neighbours"]
        if isinstance(config[dataset]["number_of_neighbours"], list)
        else [config[dataset]["number_of_neighbours"]]
    )
]

SPEARMAN_PAIRINGS = [
    {
        "dataset": dataset,
        "stimuli_type": stimuli_type,
        "model": model,
        "similarity_type": similarity_type,
    }
    for dataset in DATASETS
    for stimuli_type in config[dataset]["stimuli_dir"]
    for model in MODEL_KEYS
    if config["models"][model]["modality"] in [stimuli_type, "multimodal"]
    for similarity_type in SIMILARITY_TYPES
]

