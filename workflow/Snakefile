configfile: "config/config.yaml"

include: "fMRI_processing/Snakefile"
include: "isc_nearest_neighbours/Snakefile"
include: "llm_nearest_neighbours/Snakefile"
include: "llm_mind_alignment/Snakefile"

DATASET_KEYS = list(config["datasets"].keys())
MODEL_KEYS = list(config["models"].keys())
SIMILARITY_TYPES = list(config["similarity_metrics"])
EXCLUDED_SUBTASKS = list(config["schema_subtasks"])

rule all:
    input:
        expand(
            "results/llm/{dataset}/{similarity_type}_nearest_neighbours/{model}_{similarity_type}_nearest_neighbours.parquet",
            dataset=DATASET_KEYS,
            model=MODEL_KEYS,
            similarity_type=SIMILARITY_TYPES
        )