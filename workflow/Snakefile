configfile: "config/config.yaml"

DATASETS = list(config["datasets"])
MODEL_KEYS = list(config["models"].keys())
SIMILARITY_TYPES = list(config["similarity_types"])

def pairings():
    pairs = []

    for dataset in DATASETS:
        numbers_of_neighbours = config[dataset]["number_of_neighbours"]

        # allow both old scalar syntax and new list syntax
        if isinstance(numbers_of_neighbours, int):
            numbers_of_neighbours = [numbers_of_neighbours]

        for number_of_neighbours in numbers_of_neighbours:
            for stimuli_type in list(config[dataset]["stimuli_dir"].keys()):
                for model in MODEL_KEYS:
                    if config["models"][model]["modality"] in [stimuli_type, "multimodal"]:
                        for similarity_type in SIMILARITY_TYPES:
                            pairs.append(
                                {
                                    "dataset": dataset,
                                    "number_of_neighbours": number_of_neighbours,
                                    "stimuli_type": stimuli_type,
                                    "model": model,
                                    "similarity_type": similarity_type,
                                }
                            )

    return pairs

PAIRINGS = pairings()

# include dataset processing files
include: "dataset_processing/narratives_dataset/Snakefile"
include: "dataset_processing/caption_scene_dataset/Snakefile"

# include analysis files
include: "isc_nearest_neighbours/Snakefile"
include: "llm_nearest_neighbours/Snakefile"
include: "llm_mind_alignment/Snakefile"
