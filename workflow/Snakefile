from itertools import combinations
import re

from libraries.code_version import code_version

shell.prefix(
    'export PYTHONPATH="$PWD/workflow:$PYTHONPATH"; '
)

# check the config at startup, so a wrong value stops the pipeline before any job runs
def check_config_value(key, value, allowed):
    if value not in allowed:
        raise ValueError(f"config: {key} is {value!r}, expected one of {allowed}")

for model, model_config in config["models"].items():
    if not re.fullmatch(r".+_[^_]+", model):
        raise ValueError(f"config: model key {model!r} must be <family>_<size>")
        
    check_config_value(f"models.{model}.modality", model_config["modality"], ["language", "vision"])
    check_config_value(f"models.{model}.quantization_method", model_config["quantization_method"], [None, "4bit", "8bit"])

for similarity_type in config["similarity_types"]:
    check_config_value("similarity_types entry", similarity_type, ["cosine", "pearson", "spearman"])

check_config_value("minimum_subjects_per_stimulus", config["minimum_subjects_per_stimulus"], list(range(2, 9)))

DATASETS = list(config["datasets"])
MODEL_KEYS = list(config["models"].keys())
SIMILARITY_TYPES = list(config["similarity_types"])

NUMBER_OF_RELABELLINGS = config["number_of_relabellings"]
RANDOM_SEED = config["random_seed"]
MINIMUM_SUBJECTS_PER_STIMULUS = config["minimum_subjects_per_stimulus"]

# folder of the summary tables (all_*.tsv) that combine every configuration
TSV_SUMMARIES_DIR = "results/tsv_summaries"

def dataset_numbers_of_neighbours(dataset):
    numbers_of_neighbours = config[dataset]["number_of_neighbours"]

    # allow both old scalar syntax and new list syntax
    if isinstance(numbers_of_neighbours, int):
        numbers_of_neighbours = [numbers_of_neighbours]

    return numbers_of_neighbours

def max_number_of_neighbours(dataset):
    # the largest configured neighbourhood size for a dataset: the only k the neighbour-generation
    # rules (compute_llm_nearest_neighbours, compute_isc_nearest_neighbours) actually compute and store.
    # Every smaller configured k is a prefix slice of that one stored file (see slice_top_k_neighbours in
    # libraries/compute_nearest_neighbours.py) rather than a separately materialized file
    return max(dataset_numbers_of_neighbours(dataset))

for dataset in DATASETS:
    numbers_of_neighbours = dataset_numbers_of_neighbours(dataset)

    if not isinstance(numbers_of_neighbours, list) or not all(type(k) is int and k > 0 for k in numbers_of_neighbours):
        raise ValueError(f"config: {dataset}.number_of_neighbours must be positive integers, got {numbers_of_neighbours!r}")

def pairings():
    pairs = []

    for dataset in DATASETS:
        for number_of_neighbours in dataset_numbers_of_neighbours(dataset):
            for stimuli_type in list(config[dataset]["stimuli_dir"].keys()):
                for model in MODEL_KEYS:
                    if config["models"][model]["modality"] == stimuli_type:
                        for similarity_type in SIMILARITY_TYPES:
                            pairs.append(
                                {
                                    "dataset": dataset, 
                                    "number_of_neighbours": number_of_neighbours, 
                                    "stimuli_type": stimuli_type, 
                                    "model": model, 
                                    "similarity_type": similarity_type, 
                                }
                            )

    return pairs

PAIRINGS = pairings()

def llm_llm_pairings():
    llm_llm_pairs = []

    for dataset in DATASETS:
        available_modalities = list(config[dataset]["stimuli_dir"].keys())

        # one representation per (model, stimuli_type) the model can embed. Representations are
        # model-major, so model_1 always precedes model_2 in MODEL_KEYS
        representations = [
            (model, stimuli_type)
            for model in MODEL_KEYS
            for stimuli_type in available_modalities
            if config["models"][model]["modality"] == stimuli_type
        ]

        for number_of_neighbours in dataset_numbers_of_neighbours(dataset):
            for (model_1, modality_1), (model_2, modality_2) in combinations(representations, 2):
                for similarity_type in SIMILARITY_TYPES:
                    llm_llm_pairs.append(
                        {
                            "dataset": dataset, 
                            "number_of_neighbours": number_of_neighbours, 
                            "model_1": model_1, 
                            "stimuli_type_1": modality_1, 
                            "model_2": model_2, 
                            "stimuli_type_2": modality_2, 
                            "similarity_type": similarity_type, 
                        }
                    )

    return llm_llm_pairs

LLM_LLM_PAIRINGS = llm_llm_pairings()

HEATMAP_PAIRINGS = [
    {
        "dataset": dataset, 
        "similarity_type": similarity_type, 
        "number_of_neighbours": number_of_neighbours, 
    }
    for dataset in DATASETS
    for similarity_type in SIMILARITY_TYPES
    for number_of_neighbours in dataset_numbers_of_neighbours(dataset)
]

# one entry per (dataset, number_of_neighbours): the plots that compare the similarity types
NEIGHBOUR_PAIRINGS = [
    {
        "dataset": dataset, 
        "number_of_neighbours": number_of_neighbours, 
    }
    for dataset in DATASETS
    for number_of_neighbours in dataset_numbers_of_neighbours(dataset)
]

# one entry per (dataset, model, stimuli_type, similarity_type) — no number_of_neighbours dimension.
# Drives compute_llm_nearest_neighbours (workflow/llm_nearest_neighbours/Snakefile), which now computes
# and stores only the dataset's largest configured k; every k-specific consumer rule still iterates
# PAIRINGS and slices the k it needs from that one shared file
LLM_NEIGHBOUR_GENERATION_PAIRINGS = [
    {
        "dataset": dataset, 
        "stimuli_type": stimuli_type, 
        "model": model, 
        "similarity_type": similarity_type, 
    }
    for dataset in DATASETS
    for stimuli_type in list(config[dataset]["stimuli_dir"].keys())
    for model in MODEL_KEYS
    if config["models"][model]["modality"] == stimuli_type
    for similarity_type in SIMILARITY_TYPES
]

# one entry per (dataset, similarity_type) — the mind/ISC-side analog, no model dimension
MIND_NEIGHBOUR_GENERATION_PAIRINGS = [
    {
        "dataset": dataset, 
        "similarity_type": similarity_type, 
    }
    for dataset in DATASETS
    for similarity_type in SIMILARITY_TYPES
]

SPEARMAN_PAIRINGS = [
    {
        "dataset": dataset, 
        "stimuli_type": stimuli_type, 
        "model": model, 
        "similarity_type": similarity_type, 
    }
    for dataset in DATASETS
    for stimuli_type in config[dataset]["stimuli_dir"]
    for model in MODEL_KEYS
    if config["models"][model]["modality"] == stimuli_type
    for similarity_type in SIMILARITY_TYPES
]

# brain-model results are computed on the whole cortex (empty suffix, ISC in results/mind/) and on
# the region of each stimulus type (suffix _{stimuli_type}, ISC in results/{stimuli_type}_mind/);
# the suffix is appended to the result directories and summary TSVs
REGION_SUFFIXES = [""] + [f"_{stimuli_type}" for stimuli_type in config["atlas"]["regions"]]

wildcard_constraints:
    region_suffix = "|".join(REGION_SUFFIXES),
    mind = "|".join(["mind"] + [f"{stimuli_type}_mind" for stimuli_type in config["atlas"]["regions"]])

def in_region(region_suffix, stimuli_types):
    # whether results with this suffix cover any of these stimulus types
    return region_suffix == "" or region_suffix[1:] in stimuli_types

def pairings_in(region_suffix, pairs):
    return [pair for pair in pairs if in_region(region_suffix, [pair["stimuli_type"]])]

def mind_dir(wildcards):
    # the brain directory of a job: a region job may only read the region of its own stimulus
    # type, so a model can never be compared with the region of the other modality
    if wildcards.region_suffix == "":
        return "results/mind"

    if wildcards.region_suffix != f"_{wildcards.stimuli_type}":
        raise ValueError(
            f"Results with suffix {wildcards.region_suffix!r} cannot use "
            f"{wildcards.stimuli_type} models"
        )

    return f"results/{wildcards.stimuli_type}_mind"

