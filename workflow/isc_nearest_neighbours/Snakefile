import pandas as pd
from pathlib import Path

rule all_isc_nearest_neighbours:
    input:
        isc_nearest_neighbours = [
            f"results/mind/{pair['dataset']}/isc_{pair['similarity_type']}_nearest_neighbours.parquet"
            for pair in MIND_NEIGHBOUR_GENERATION_PAIRINGS
        ], 
        all_isc_reliability = "results/mind/all_isc_reliability.tsv"

def isc_done_for_dataset(wc):
    return config[wc.dataset]["processing_output_dir"] + "/manifests/.isc_done"

def isc_dir_for_dataset(wc):
    return config[wc.dataset]["processing_output_dir"] + "/isc"

checkpoint create_isc_manifest:
    input:
        isc_done = isc_done_for_dataset, 
        excluded_stimuli = lambda wc: config[wc.dataset]["excluded_stimuli"], 
        stimuli_ready = lambda wc: config[wc.dataset]["stimuli_ready"]
    output:
        output_manifest = "results/mind/{dataset}/manifests/isc_inputs.tsv"
    params:
        dataset = "{dataset}", 
        isc_dir = isc_dir_for_dataset, 
        stimuli_dirs = lambda wc: list(config[wc.dataset]["stimuli_dir"].values())
    conda:
        "envs/isc_nearest_neighbours_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/create_isc_manifest.py \
                --dataset {params.dataset:q} \
                --isc_dir {params.isc_dir:q} \
                --excluded_stimuli {input.excluded_stimuli:q} \
                --stimuli_dirs {params.stimuli_dirs:q} \
                --output_manifest {output.output_manifest:q}
        """

def isc_npys_from_manifest(wc):
    manifest = checkpoints.create_isc_manifest.get(
        dataset = wc.dataset
    ).output.output_manifest

    df = pd.read_csv(manifest, sep = "\t")

    return df["isc_file"].tolist()

rule create_isc_dataframe:
    input:
        isc_npys = isc_npys_from_manifest
    output:
        isc_dataframe = "results/mind/{dataset}/isc_dataframe.parquet"
    conda:
        "envs/isc_nearest_neighbours_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/create_isc_dataframe.py \
                --isc_npys {input.isc_npys:q} \
                --isc_dataframe {output.isc_dataframe:q}
        """

rule compute_isc_nearest_neighbours:
    # computes similarity blockwise straight from the ISC dataframe and keeps only the dataset's largest
    # configured number_of_neighbours per concept — the dense N x N similarity matrix is never written
    # to disk. Output is unversioned by k: every k-specific consumer rule slices the k it needs from this
    # one file via slice_top_k_neighbours
    input:
        isc_dataframe = "results/mind/{dataset}/isc_dataframe.parquet"
    output:
        isc_cosine_nearest_neighbours = "results/mind/{dataset}/isc_cosine_nearest_neighbours.parquet", 
        isc_pearson_nearest_neighbours = "results/mind/{dataset}/isc_pearson_nearest_neighbours.parquet", 
        isc_spearman_nearest_neighbours = "results/mind/{dataset}/isc_spearman_nearest_neighbours.parquet"
    params:
        number_of_neighbours = lambda wc: max_number_of_neighbours(wc.dataset)
    conda:
        "envs/isc_nearest_neighbours_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/compute_isc_nearest_neighbours.py \
                --isc_dataframe {input.isc_dataframe:q} \
                --number_of_neighbours {params.number_of_neighbours:q} \
                --isc_cosine_nearest_neighbours {output.isc_cosine_nearest_neighbours:q} \
                --isc_pearson_nearest_neighbours {output.isc_pearson_nearest_neighbours:q} \
                --isc_spearman_nearest_neighbours {output.isc_spearman_nearest_neighbours:q}
        """

# column names of each dataset's ISC manifest, and whether its ISC truncates to the shortest run
ISC_MANIFEST_LAYOUT = {
    "caption_scene": {"stimulus_column": "stimulus_id", "parcel_column": "parcel_ts", "truncate": False}, 
    "narratives": {"stimulus_column": "task", "parcel_column": "parcel_ts", "truncate": True}, 
    "nature_stories": {"stimulus_column": "task", "parcel_column": "parcel_ts", "truncate": False}, 
    "nsd_data": {"stimulus_column": "stimulus_id", "parcel_column": "parcel_time_series", "truncate": False}, 
}

rule compute_isc_reliability:
    # split-half reliability of every stimulus's ISC vector, on exactly the data behind the ISC
    # (same files, truncation and repeat averaging); TODO S30
    input:
        isc_done = isc_done_for_dataset, 
        isc_manifest = lambda wc: config[wc.dataset]["processing_output_dir"] + "/manifests/isc_manifest.tsv"
    output:
        isc_reliability = "results/mind/{dataset}/isc_reliability.tsv"
    params:
        stimulus_column = lambda wc: ISC_MANIFEST_LAYOUT[wc.dataset]["stimulus_column"], 
        parcel_column = lambda wc: ISC_MANIFEST_LAYOUT[wc.dataset]["parcel_column"], 
        truncate_arg = lambda wc: "--truncate_to_shortest" if ISC_MANIFEST_LAYOUT[wc.dataset]["truncate"] else "", 
        n_rois = config["atlas"]["n_rois"], 
        number_of_splits = config["isc_reliability_number_of_splits"], 
        random_seed = RANDOM_SEED
    conda:
        "envs/isc_nearest_neighbours_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/compute_isc_reliability.py \
                --manifest {input.isc_manifest:q} \
                --stimulus_column {params.stimulus_column:q} \
                --parcel_column {params.parcel_column:q} \
                {params.truncate_arg} \
                --n_rois {params.n_rois} \
                --number_of_splits {params.number_of_splits} \
                --random_seed {params.random_seed} \
                --output {output.isc_reliability:q}
        """

rule aggregate_isc_reliability:
    # one row per dataset: ISC reliability and the distribution of the ISC values; a final result
    # (source for the methods text)
    input:
        reliability_tsvs = [f"results/mind/{dataset}/isc_reliability.tsv" for dataset in DATASETS], 
        isc_dataframes = [f"results/mind/{dataset}/isc_dataframe.parquet" for dataset in DATASETS]
    output:
        all_isc_reliability = "results/mind/all_isc_reliability.tsv"
    params:
        datasets = DATASETS
    conda:
        "envs/isc_nearest_neighbours_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/aggregate_isc_reliability.py \
                --datasets {params.datasets:q} \
                --reliability_tsvs {input.reliability_tsvs:q} \
                --isc_dataframes {input.isc_dataframes:q} \
                --output {output.all_isc_reliability:q}
        """
