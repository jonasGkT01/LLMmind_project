import pandas as pd
from pathlib import Path

DATASETS = list(config["datasets"])
SIMILARITY_TYPES = list(config["similarity_metrics"])

def dataset_neighbour_pairs():
    pairs = []

    for dataset in DATASETS:
        nn = config[dataset]["number_of_neighbours"]

        # allow both old scalar syntax and new list syntax
        if isinstance(nn, int):
            nn = [nn]

        for number_of_neighbours in nn:
            pairs.append(
                {
                    "dataset": dataset,
                    "number_of_neighbours": number_of_neighbours,
                }
            )

    return pairs

DATASET_NN_PAIRS = dataset_neighbour_pairs()

rule all_isc_nearest_neighbours:
    input:
        [
            f"results/mind/{pair['dataset']}/{similarity_type}_nearest_neighbours/isc_{similarity_type}_nearest_neighbours_{pair['number_of_neighbours']}NN.parquet"
            for pair in DATASET_NN_PAIRS
            for similarity_type in SIMILARITY_TYPES
        ]

def isc_done_for_dataset(wc):
    return config[wc.dataset]["processing_output_dir"] + "/manifests/.isc_done"

def isc_dir_for_dataset(wc):
    return config[wc.dataset]["processing_output_dir"] + "/isc"

checkpoint create_isc_manifest:
    input:
        isc_done=isc_done_for_dataset
    output:
        output_manifest="results/mind/{dataset}/manifests/isc_inputs.tsv"
    params:
        isc_dir=isc_dir_for_dataset
    conda:
        "envs/create_isc_manifest_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/create_isc_manifest.py \
                --dataset {wildcards.dataset:q} \
                --isc_dir {params.isc_dir:q} \
                --output_manifest {output.output_manifest:q}
        """

def isc_npys_from_manifest(wc):
    manifest = checkpoints.create_isc_manifest.get(
        dataset=wc.dataset
    ).output.output_manifest

    df = pd.read_csv(manifest, sep="\t")

    return df["isc_file"].tolist()

rule create_isc_dataframe:
    input:
        isc_npys_from_manifest
    output:
        isc_dataframe="results/mind/{dataset}/isc_dataframe.parquet"
    conda:
        "envs/create_isc_dataframe_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/create_isc_dataframe.py \
                --isc_npys {input:q} \
                --isc_dataframe {output.isc_dataframe:q}
        """

rule compute_isc_similarity:
    input:
        isc_dataframe="results/mind/{dataset}/isc_dataframe.parquet"
    output:
        isc_cosine_similarity_dataframe="results/mind/{dataset}/isc_cosine_similarity.parquet",
        isc_pearson_similarity_dataframe="results/mind/{dataset}/isc_pearson_similarity.parquet"
    conda:
        "envs/compute_isc_similarity_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/compute_isc_similarity.py \
                --isc_dataframe {input.isc_dataframe:q} \
                --isc_cosine_similarity_dataframe {output.isc_cosine_similarity_dataframe:q} \
                --isc_pearson_similarity_dataframe {output.isc_pearson_similarity_dataframe:q}
        """

rule compute_isc_nearest_neighbours:
    input:
        isc_cosine_similarity_dataframe="results/mind/{dataset}/isc_cosine_similarity.parquet",
        isc_pearson_similarity_dataframe="results/mind/{dataset}/isc_pearson_similarity.parquet"
    output:
        isc_cosine_nearest_neighbours="results/mind/{dataset}/isc_cosine_nearest_neighbours_{number_of_neighbours}NN.parquet",
        isc_pearson_nearest_neighbours="results/mind/{dataset}/isc_pearson_nearest_neighbours_{number_of_neighbours}NN.parquet"
    params:
        number_of_neighbours=lambda wc: wc.number_of_neighbours
    conda:
        "envs/compute_isc_nearest_neighbours_environment.yaml"
    shell:
        r"""
            python3 workflow/isc_nearest_neighbours/scripts/compute_isc_nearest_neighbours.py \
                --isc_cosine_similarity_dataframe {input.isc_cosine_similarity_dataframe:q} \
                --isc_pearson_similarity_dataframe {input.isc_pearson_similarity_dataframe:q} \
                --isc_cosine_nearest_neighbours {output.isc_cosine_nearest_neighbours:q} \
                --isc_pearson_nearest_neighbours {output.isc_pearson_nearest_neighbours:q} \
                --number_of_neighbours {params.number_of_neighbours}
        """