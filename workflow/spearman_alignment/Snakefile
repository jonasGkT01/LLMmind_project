rule all_spearman_alignment:
    input:
        spearman_model_level = [
            f"results/spearman_alignment_scores{region_suffix}/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_empirical_{pair['similarity_type']}-spearman_alignment_model_level.p_value.tsv"
            for region_suffix in REGION_SUFFIXES
            for pair in pairings_in(region_suffix, SPEARMAN_PAIRINGS)
        ], 
        spearman_concept_level = [
            f"results/spearman_alignment_scores{region_suffix}/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_empirical_{pair['similarity_type']}-spearman_alignment_concept_level.p_value.tsv"
            for region_suffix in REGION_SUFFIXES
            for pair in pairings_in(region_suffix, SPEARMAN_PAIRINGS)
        ], 
        spearman_summary = [
            f"results/all_spearman_alignment_scores{region_suffix}.tsv"
            for region_suffix in REGION_SUFFIXES
        ]

rule compute_spearman_alignment_with_empirical_p_value:
    input:
        brain_embeddings = lambda wc: f"{mind_dir(wc)}/{wc.dataset}/isc_dataframe.parquet", 
        model_embeddings = "results/{stimuli_type}_models/{dataset}/embeddings/{model}_embeddings.parquet"
    output:
        model_level = "results/spearman_alignment_scores{region_suffix}/dataset-{dataset}_model-{model}-{stimuli_type}_brain_empirical_{similarity_type}-spearman_alignment_model_level.p_value.tsv", 
        concept_level = "results/spearman_alignment_scores{region_suffix}/dataset-{dataset}_model-{model}-{stimuli_type}_brain_empirical_{similarity_type}-spearman_alignment_concept_level.p_value.tsv"
    params:
        number_of_relabellings = NUMBER_OF_RELABELLINGS, 
        random_seed = RANDOM_SEED
    conda:
        "envs/spearman_alignment_environment.yaml"
    shell:
        r"""
            python3 workflow/spearman_alignment/scripts/compute_spearman_alignment_with_empirical_p_value.py \
                --brain_embeddings {input.brain_embeddings:q} \
                --model_embeddings {input.model_embeddings:q} \
                --model_level_output {output.model_level:q} \
                --concept_level_output {output.concept_level:q} \
                --dataset {wildcards.dataset:q} \
                --model {wildcards.model:q} \
                --stimuli_type {wildcards.stimuli_type:q} \
                --similarity_type {wildcards.similarity_type:q} \
                --number_of_relabellings {params.number_of_relabellings} \
                --random_seed {params.random_seed}
        """

AGGREGATE_ALL_SPEARMAN_OUTPUTS_SCRIPT = "workflow/spearman_alignment/scripts/aggregate_all_spearman_outputs.py"

rule aggregate_all_spearman_alignment_scores:
    input:
        model_level_scores = lambda wc: [
            f"results/spearman_alignment_scores{wc.region_suffix}/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_empirical_{pair['similarity_type']}-spearman_alignment_model_level.p_value.tsv"
            for pair in pairings_in(wc.region_suffix, SPEARMAN_PAIRINGS)
        ]
    output:
        all_spearman_alignment_scores_tsv = "results/all_spearman_alignment_scores{region_suffix}.tsv"
    params:
        code = code_version(AGGREGATE_ALL_SPEARMAN_OUTPUTS_SCRIPT)
    conda:
        "envs/spearman_alignment_environment.yaml"
    shell:
        r"""
            python3 {AGGREGATE_ALL_SPEARMAN_OUTPUTS_SCRIPT:q} \
                --model_level_scores {input.model_level_scores:q} \
                --all_spearman_alignment_scores_tsv {output.all_spearman_alignment_scores_tsv:q}
        """
