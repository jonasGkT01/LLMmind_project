rule compute_model_level_spearman_empirical_p_value:
    input:
        observed_alignment="results/global_geometry_alignment/model_level/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-similarity_spearman-alignment.parquet",
        relabelled_alignment="results/global_geometry_alignment/model_level/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-similarity_spearman-alignment_relabelled.parquet"
    output:
        empirical_p_value="results/global_geometry_alignment/model_level/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-similarity_spearman-alignment_empirical.p_value.tsv"
    conda:
        "envs/compute_empirical_p_value_environment.yaml"
    shell:
        r"""
            python3 workflow/global_geometry_alignment/scripts/compute_model_level_empirical_p_value.py \
                --observed_alignment {input.observed_alignment:q} \
                --relabelled_alignment {input.relabelled_alignment:q} > {output.empirical_p_value:q}
        """

