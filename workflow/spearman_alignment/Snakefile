SPEARMAN_PAIRINGS = [
    {
        "dataset": dataset,
        "stimuli_type": stimuli_type,
        "model": model,
        "similarity_type": similarity_type,
    }
    for dataset in DATASETS
    for stimuli_type in config[dataset]["stimuli_dir"]
    for model in MODEL_KEYS
    if config["models"][model]["modality"] in [stimuli_type, "multimodal"]
    for similarity_type in SIMILARITY_TYPES
]

rule all_spearman_alignment:
    input:
        [
            f"results/spearman_alignment/model_level/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_{pair['similarity_type']}-similarity_spearman_alignment_empirical.p_value.tsv"
            for pair in SPEARMAN_PAIRINGS
        ],
        [
            f"results/spearman_alignment/concept_level/dataset-{pair['dataset']}_model-{pair['model']}-{pair['stimuli_type']}_brain_{pair['similarity_type']}-similarity_spearman_alignment_empirical.p_value.tsv"
            for pair in SPEARMAN_PAIRINGS
        ]

rule compute_spearman_alignmentwith_empirical_p_value:
    input:
        brain_similarity="results/mind/{dataset}/isc_{similarity_type}_similarity.parquet",
        model_similarity="results/{stimuli_type}_models/{dataset}/{similarity_type}_similarity/{model}_{similarity_type}_similarity.parquet"
    output:
        model_level="results/spearman_alignment/model_level/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-similarity_spearman_alignment_empirical.p_value.tsv",
        concept_level="results/spearman_alignment/concept_level/dataset-{dataset}_model-{model}-{stimuli_type}_brain_{similarity_type}-similarity_spearman_alignment_empirical.p_value.tsv"
    params:
        number_of_relabellings=NUMBER_OF_RELABELLINGS,
        random_seed=RANDOM_SEED
    conda:
        "envs/spearman_alignment_environment.yaml"
    shell:
        r"""
            python3 workflow/spearman_alignment/scripts/compute_spearman_alignment_with_empirical_p_value.py \
                --brain_similarity {input.brain_similarity:q} \
                --model_similarity {input.model_similarity:q} \
                --model_level_output {output.model_level:q} \
                --concept_level_output {output.concept_level:q} \
                --dataset {wildcards.dataset:q} \
                --model {wildcards.model:q} \
                --stimuli_type {wildcards.stimuli_type:q} \
                --similarity_type {wildcards.similarity_type:q} \
                --number_of_relabellings {params.number_of_relabellings} \
                --random_seed {params.random_seed}
        """