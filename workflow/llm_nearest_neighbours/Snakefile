DATASETS = list(config["datasets"])
MODEL_KEYS = list(config["models"].keys())
SIMILARITY_TYPES = list(config["similarity_metrics"])
EXCLUDED_SUBTASKS = list(config["narratives"]["schema_subtasks"])
NUMBER_OF_NEIGHBOURS = list(config["number_of_neighbours"])

rule all_llm_nearest_neighbours:
    input:
        expand(
            "results/llm/{dataset}/{similarity_type}_nearest_neighbours/{model}_{similarity_type}_nearest_neighbours_{number_of_neighbours}NN.parquet",
            dataset=DATASETS,
            model=MODEL_KEYS,
            similarity_type=SIMILARITY_TYPES,
            number_of_neighbours=NUMBER_OF_NEIGHBOURS
        )

rule download_pretrained_llm:
    output:
        model_dir=directory("resources/models/{model}")
    params:
        hf_name=lambda wc: config["models"][wc.model]["hf_name"]
    conda:
        "envs/download_pretrained_llm_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_nearest_neighbours/scripts/download_pretrained_llm.py {params.hf_name:q} {output.model_dir:q}
        """

rule get_embeddings:
    input:
        model="resources/models/{model}",
        stimuli=lambda wc: config[wc.dataset]["stimuli"]
    output:
        "results/llm/{dataset}/embeddings/{model}_embeddings.parquet"
    params:
        quantization_arg=lambda wc: (
            "" if config['models'][wc.model]['quantization_method'] is None
            else f"--quantization_method {config['models'][wc.model]['quantization_method']}"
        ),
        excluded_stimuli=EXCLUDED_SUBTASKS
    conda:
        "envs/get_embeddings_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_nearest_neighbours/scripts/get_embeddings.py \
                --input_dir {input.stimuli} \
                --output {output} \
                --model_path {input.model} \
                {params.quantization_arg} \
                --excluded_stimuli {params.excluded_stimuli:q}
        """

rule compute_similarity:
    input:
        embedding_dataframe="results/llm/{dataset}/embeddings/{model}_embeddings.parquet"
    output:
        cosine_similarity_dataframe="results/llm/{dataset}/cosine_similarity/{model}_cosine_similarity.parquet",
        pearson_similarity_dataframe="results/llm/{dataset}/pearson_similarity/{model}_pearson_similarity.parquet"
    conda:
        "envs/compute_similarity_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_nearest_neighbours/scripts/compute_similarity.py \
                --embedding_dataframe {input.embedding_dataframe:q} \
                --cosine_similarity_dataframe {output.cosine_similarity_dataframe:q} \
                --pearson_similarity_dataframe {output.pearson_similarity_dataframe:q}
        """

rule relabel_llm_similarity:
    input:
        similarity_dataframe="results/llm/{dataset}/{similarity_type}_similarity/{model}_{similarity_type}_similarity.parquet"
    output:
        relabelled_similarity_dataframe=temp("results/llm/relabelled_similarity/{dataset}/{similarity_type}_similarity/{model}_{similarity_type}_similarity_dataframe_relabel_{relabel}.parquet")
    params:
        seed=lambda wc: config["random_seed"] + int(wc.relabel)
    conda:
        "envs/relabel_llm_similarity_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_nearest_neighbours/scripts/relabel_llm_similarity.py \
                --input {input.similarity_dataframe:q} \
                --output {output.relabelled_similarity_dataframe:q} \
                --seed {params.seed}
        """

rule compute_nearest_neighbours:
    input:
        cosine_similarity_dataframe="results/llm/{dataset}/cosine_similarity/{model}_cosine_similarity.parquet",
        pearson_similarity_dataframe="results/llm/{dataset}/pearson_similarity/{model}_pearson_similarity.parquet"
    output:
        cosine_nearest_neighbours="results/llm/{dataset}/cosine_nearest_neighbours/{model}_cosine_nearest_neighbours_{number_of_neighbours}NN.parquet",
        pearson_nearest_neighbours="results/llm/{dataset}/pearson_nearest_neighbours/{model}_pearson_nearest_neighbours_{number_of_neighbours}NN.parquet"
    params:
        number_of_neighbours=lambda wc: wc.number_of_neighbours
    conda:
        "envs/compute_nearest_neighbours_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_nearest_neighbours/scripts/compute_nearest_neighbours.py \
                --number_of_neighbours {params.number_of_neighbours:q} \
                --cosine_similarity_dataframe {input.cosine_similarity_dataframe:q} \
                --pearson_similarity_dataframe {input.pearson_similarity_dataframe:q} \
                --cosine_nearest_neighbours {output.cosine_nearest_neighbours:q} \
                --pearson_nearest_neighbours {output.pearson_nearest_neighbours:q}
        """

rule compute_relabelled_LLM_nearest_neighbours:
    input:
        relabelled_cosine_similarity_dataframe="results/llm/relabelled_similarity/{dataset}/cosine_similarity/{model}_cosine_similarity_dataframe_relabel_{relabel}.parquet",
        relabelled_pearson_similarity_dataframe="results/llm/relabelled_similarity/{dataset}/pearson_similarity/{model}_pearson_similarity_dataframe_relabel_{relabel}.parquet"
    output:
        relabelled_cosine_nearest_neighbours=temp("results/llm/relabelled_similarity/{dataset}/cosine_nearest_neighbours/{model}_cosine_nearest_neighbours_{number_of_neighbours}NN_relabel_{relabel}.parquet"),
        relabelled_pearson_nearest_neighbours=temp("results/llm/relabelled_similarity/{dataset}/pearson_nearest_neighbours/{model}_pearson_nearest_neighbours_{number_of_neighbours}NN_relabel_{relabel}.parquet")
    params:
        number_of_neighbours=lambda wc: wc.number_of_neighbours
    conda:
        "envs/compute_nearest_neighbours_environment.yaml"
    shell:
        r"""
            python3 workflow/llm_nearest_neighbours/scripts/compute_nearest_neighbours.py \
                --number_of_neighbours {params.number_of_neighbours} \
                --cosine_similarity_dataframe {input.relabelled_cosine_similarity_dataframe:q} \
                --pearson_similarity_dataframe {input.relabelled_pearson_similarity_dataframe:q} \
                --cosine_nearest_neighbours {output.relabelled_cosine_nearest_neighbours:q} \
                --pearson_nearest_neighbours {output.relabelled_pearson_nearest_neighbours:q}
        """